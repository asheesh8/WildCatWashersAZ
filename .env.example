# Where the quote form posts. Any service that accepts a plain POST works:
# Formspree, Basin, a Zapier/Make catch hook, or your own function.
#
#   Vercel:  Project → Settings → Environment Variables → add PUBLIC_QUOTE_ENDPOINT
#   Netlify: not needed — Netlify Forms handles the form natively.
#
# Leave it unset and the form will NOT silently fail: the visitor is shown a
# call/email fallback with their answers pre-filled into the message.
PUBLIC_QUOTE_ENDPOINT=

# Optional for Netlify-hosted custom domains when NETLIFY is not present during build.
# PUBLIC_FORM_PROVIDER=netlify
