---
import type { Review } from '@/data/reviews';
import { displayName, placeLabel } from '@/data/reviews';
export interface Props { review: Review; large?: boolean }
const { review: r, large = false } = Astro.props;
const place = placeLabel(r);
const service = r.services[0];
---
<figure class:list={['rcard', large && 'rcard-lg', 'reveal']}>
  <div class="rcard-top">
    <span class="stars" role="img" aria-label="Five stars">★★★★★</span>
    <span class="rcard-platform">{r.platform}</span>
  </div>
  <blockquote><p>{r.text}</p></blockquote>
  <figcaption>
    <span class="rcard-avatar" aria-hidden="true">{displayName(r)[0]}</span>
    <span>
      <strong>{displayName(r)}</strong>
      <span class="rcard-meta">{[place, service].filter(Boolean).join(' · ')}</span>
    </span>
  </figcaption>
</figure>

<style>
  .rcard {
    display: flex; flex-direction: column; gap: 1rem; height: 100%;
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: clamp(1.3rem, 1rem + 1vw, 2rem); box-shadow: var(--shadow-sm);
  }
  .rcard-top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .rcard-platform { font-size: 1rem; font-weight: 750; color: var(--ink-3); text-transform: uppercase; letter-spacing: .08em; }
  .rcard blockquote { flex: 1; }
  .rcard p { font-size: 1.12rem; line-height: 1.55; color: var(--ink); }
  .rcard-lg p { font-size: var(--step-1); line-height: 1.45; font-weight: 500; }
  figcaption { display: flex; gap: .8rem; align-items: center; }
  figcaption strong { display: block; font-family: var(--font-display); font-weight: 800; font-size: 1.1rem; }
  .rcard-avatar {
    width: 46px; height: 46px; border-radius: 50%; flex: none; display: grid; place-items: center;
    background: var(--blue); color: var(--navy); font-family: var(--font-display); font-weight: 900; font-size: 1.2rem;
  }
  .rcard-meta { color: var(--ink-3); font-size: 1rem; }
</style>
