---
import { processSteps } from '@/data/business';
export interface Props { title?: string }
const { title = 'Booking takes one phone call' } = Astro.props;
---
<section class="section" aria-labelledby="process-title">
  <div class="wrap">
    <div class="section-head center">
      <p class="eyebrow">How it works</p>
      <h2 id="process-title" class="h2 sweep">{title}</h2>
    </div>
    <ol class="steps m-swipe" role="list">
      {processSteps.map((s, i) => (
        <li class="step reveal">
          <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="h3">{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .steps { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); counter-reset: s; }
  .step { position: relative; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 1.5rem 1.4rem; display: grid; gap: .6rem; align-content: start; }
  .step-n { font-family: var(--font-display); font-weight: 900; font-size: 2.6rem; line-height: 1; color: var(--blue-600); }
  .step p { color: var(--ink-2); font-size: 1.08rem; }
</style>
