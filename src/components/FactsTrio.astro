---
/** How it's priced, how often, how long — plus the honest limits (never promise what we can't). */
import Icon from './Icon.astro';
export interface Props { pricing: string; frequency: string; duration: string; limits?: string[] }
const { pricing, frequency, duration, limits = [] } = Astro.props;
const facts = [
  { icon: 'message', title: 'How it’s priced', body: pricing },
  { icon: 'calendar', title: 'How often', body: frequency },
  { icon: 'clock', title: 'How long it takes', body: duration },
];
---
<section class="section bg-mist">
  <div class="wrap">
    <ul class="trio" role="list">
      {facts.map((f) => (
        <li class="card reveal"><span class="tri-i"><Icon name={f.icon} size={26} /></span><h2 class="h3">{f.title}</h2><p>{f.body}</p></li>
      ))}
    </ul>
    {limits.length > 0 && (
      <div class="limits reveal">
        <h2 class="h3">Straight talk: what we won’t promise</h2>
        <ul>{limits.map((l) => <li>{l}</li>)}</ul>
      </div>
    )}
  </div>
</section>
<style>
  .trio { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .trio li { display: grid; gap: .6rem; align-content: start; }
  .tri-i { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: var(--blue); color: var(--navy); }
  .trio p { color: var(--ink-2); }
  .limits { margin-top: 1rem; border: 2px dashed var(--line-strong); border-radius: var(--radius-lg); padding: 1.6rem; background: #fff; }
  .limits ul { margin-top: .7rem; padding-left: 1.2rem; display: grid; gap: .4rem; color: var(--ink-2); }
</style>
