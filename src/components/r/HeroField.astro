---
/**
 * Service × town hero: a field report. The headline runs the full width; under a
 * rule sit the job photo (its own shape), the local answer with the action, and a
 * short "here" panel of facts that are true of this town (review count, the
 * neighborhoods we visit, the award readers gave us there).
 */
import Breadcrumbs from '../Breadcrumbs.astro';
import Photo from './Photo.astro';
import HeroTitle from './HeroTitle.astro';
import HeroLede from './HeroLede.astro';
import HeroCta from './HeroCta.astro';
export interface Props { title: string; lede?: string; crumbs: { name: string; href: string }[]; photo?: string; ctaLabel?: string; ctaHref?: string; facts: { term: string; body: string }[]; factsTitle: string; flip?: boolean }
const { title, lede, crumbs, photo, ctaLabel, ctaHref, facts, factsTitle, flip = false } = Astro.props;
---
<section class:list={['hfield', flip && 'is-flip']}>
  <div class="wrap">
    <div class="hf-top">
      <Breadcrumbs items={crumbs} />
      <HeroTitle title={title} size="xl" />
    </div>
    <div class="hf-grid">
      {photo && <Photo k={photo} class="hf-ph" shapes={[0.75, 0.8, 1, 4 / 3]} eager caption sizes="(min-width: 1000px) 28vw, 100vw" widths={[400, 600, 800]} />}
      <div class="hf-copy">
        <HeroCta label={ctaLabel} href={ctaHref} track="service-town-hero" />
        <HeroLede text={lede} clampAt={230} />
      </div>
      {facts.length > 0 && (
        <aside class="hf-facts" aria-label={factsTitle}>
          <h2 class="hf-ft">{factsTitle}</h2>
          <dl>{facts.map((f) => <div><dt>{f.term}</dt><dd>{f.body}</dd></div>)}</dl>
        </aside>
      )}
    </div>
  </div>
</section>
<style>
  .hfield { background: #fff; padding-block: clamp(1.3rem, 1rem + 2vw, 2.8rem) clamp(2rem, 1.5rem + 3vw, 4rem); border-bottom: 1px solid var(--line); }
  .hf-top { display: grid; gap: 1rem; padding-bottom: clamp(1.2rem, 1rem + 1.5vw, 2.2rem); border-bottom: 3px solid var(--blue); }
  .hf-top :global(.htitle) { max-width: 24ch; }
  .hf-grid { display: grid; gap: 1.3rem; margin-top: clamp(1.2rem, 1rem + 1.5vw, 2.4rem); }
  @media (min-width: 1000px) {
    .hf-grid { grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) minmax(0, 4fr); gap: clamp(1.6rem, 3vw, 3rem); align-items: start; }
    .is-flip .hf-grid { grid-template-columns: minmax(0, 6fr) minmax(0, 4fr) minmax(0, 4fr); }
    .is-flip .hf-grid :global(.hf-ph) { order: 1; }
    .is-flip .hf-copy { order: 0; }
    .is-flip .hf-facts { order: 2; }
    .hf-copy { padding-top: .2rem; }
  }
  @media (min-width: 760px) and (max-width: 999px) { .hf-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } .hf-facts { grid-column: 1 / -1; } }
  .hf-copy { display: grid; gap: 1.1rem; align-content: start; justify-items: start; }
  .hf-copy :global(.hlede) { font-size: 1.18rem; }
  .hf-facts { background: var(--blue-50); border-radius: var(--radius); padding: 1.2rem 1.3rem; }
  .hf-ft { font-family: var(--font-display); font-weight: 900; font-size: 1.2rem; color: var(--navy); margin-bottom: .5rem; }
  .hf-facts dl { margin: 0; display: grid; }
  .hf-facts div { padding: .7rem 0; border-top: 1px solid var(--blue-200); }
  .hf-facts dt { font-weight: 800; color: var(--navy); font-size: 1.04rem; }
  .hf-facts dd { margin: .15rem 0 0; color: var(--ink-2); font-size: 1.04rem; line-height: 1.45; }
  @media (max-width: 759px) {
    .hfield :global(.crumbs li:last-child) { display: none; }
    .hf-top { padding-bottom: 1rem; }
    .hf-grid { display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem; }
    .hf-copy { display: contents; }
    .hf-copy :global(.hcta) { order: -1; width: 100%; }
    .hfield :global(.hf-ph .ph-frame) { aspect-ratio: 4 / 3; }
    .hfield :global(.hf-ph) { order: 0; }
    .hf-copy :global(.hlede), .hf-copy :global(.hlede-more) { order: 1; }
    .hf-facts { order: 2; }
  }
</style>
