---
/** Sentences that matter one by one (local conditions), each on its own ruled line with a drawn icon. Heading to the side on wide screens. */
import Icon from '../Icon.astro';
export interface Props { title: string; items: string[]; intro?: string; tone?: 'plain' | 'mist' | 'blue'; mfold?: boolean; size?: 'lg' | 'md' }
const { title, items, intro, tone = 'mist', mfold = false, size = 'lg' } = Astro.props;
const iconFor = (t: string) => (/water|mineral|sprinkler|rain|monsoon|spot/i.test(t) ? 'droplet' : /sun|heat|uv|summer|hot/i.test(t) ? 'sun' : /season|winter|snowbird|away|arrive|months/i.test(t) ? 'calendar' : /pigeon|bird/i.test(t) ? 'home' : 'sparkle');
---
<section class:list={['section-tight rl', tone === 'mist' && 'bg-mist', tone === 'blue' && 'rl-blue', `rl-${size}`]} data-mfold={mfold ? '' : undefined}>
  <div class="wrap rl-grid">
    <div class="rl-head"><h2 class="h2">{title}</h2>{intro && <p>{intro}</p>}</div>
    <ul role="list">{items.map((t) => <li><span class="rl-i" aria-hidden="true"><Icon name={iconFor(t)} size={22} /></span><p>{t}</p></li>)}</ul>
  </div>
</section>
<style>
  .rl-blue { background: var(--blue-100); }
  .rl-grid { display: grid; gap: 1.2rem; }
  @media (min-width: 1000px) { .rl-grid { grid-template-columns: minmax(0, .85fr) minmax(0, 1.5fr); gap: 3rem; align-items: start; } }
  .rl-head { display: grid; gap: .7rem; }
  .rl-head p { color: var(--ink-2); font-size: 1.1rem; }
  ul { list-style: none; padding: 0; margin: 0; border-top: 2px solid var(--navy); }
  li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; align-items: start; padding: 1.1rem 0; border-bottom: 1px solid var(--line-strong); }
  .rl-i { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--navy); color: var(--blue); }
  li p { font-size: var(--step-1); line-height: 1.45; color: var(--navy); font-weight: 500; }
  .rl-md li p { font-size: 1.14rem; line-height: 1.55; color: var(--ink-2); }
  @media (max-width: 699px) { li { gap: .8rem; padding: .9rem 0; } li p { font-size: 1.12rem; line-height: 1.5; } .rl-i { width: 34px; height: 34px; } }
</style>
