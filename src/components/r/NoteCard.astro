---
/** A short note for one neighborhood, signed in the brand script. Facts only; the note is the layout. */
import Icon from '../Icon.astro';
import { company, telHref } from '@/data/business';
export interface Props { to: string; title: string; body: string; sign?: string }
const { to, title, body, sign = 'The Wildcat Washers crew' } = Astro.props;
---
<aside class="note">
  <p class="note-to">For {to}</p>
  <h2 class="note-t">{title}</h2>
  <p class="note-b">{body}</p>
  <p class="script note-sign">{sign}</p>
  <a class="note-call" href={telHref} data-track="call-note"><Icon name="phone" size={22} />{company.phone}</a>
</aside>
<style>
  .note { position: relative; background: #fffdf6; border: 1px solid #eadfc4; border-radius: 6px; padding: clamp(1.4rem, 1rem + 2vw, 2.4rem); box-shadow: 0 1px 2px rgb(18 24 50 / 8%), 0 22px 40px -26px rgb(18 24 50 / 45%);
    background-image: repeating-linear-gradient(180deg, transparent 0 2.05rem, rgb(54 198 244 / 18%) 2.05rem calc(2.05rem + 1px)); background-position: 0 4.6rem; display: grid; gap: .7rem; align-content: start; }
  .note-to { font-weight: 800; color: var(--blue-700); font-size: 1.05rem; }
  .note-t { font-family: var(--font-display); font-weight: 900; font-size: clamp(1.45rem, 1.2rem + 1vw, 2rem); line-height: 1.1; color: var(--navy); }
  .note-b { font-size: 1.14rem; line-height: 1.8; color: var(--ink); }
  .note-sign { font-size: 1.9rem; color: var(--navy); line-height: 1; margin-top: .2rem; }
  .note-call { display: inline-flex; align-items: center; gap: .55rem; min-height: 48px; font-family: var(--font-display); font-weight: 850; font-size: 1.35rem; color: var(--navy); text-decoration: none; }
  .note-call :global(svg) { color: var(--blue-700); }
  @media (max-width: 759px) { .note-call { display: none; } }
</style>
