---
/** Ruled facts table: a term and its answer per row. Reads like a spec sheet, not a row of cards. */
import DepthText from '../DepthText.astro';
export interface Props { rows: { term: string; body: string; note?: string }[]; title?: string; intro?: string; tone?: 'plain' | 'mist' | 'blue'; id?: string; compact?: boolean; wrap?: boolean }
const { rows, title, intro, tone = 'plain', id, compact = false, wrap = true } = Astro.props;
---
{wrap ? (
  <section class:list={['section-tight', tone === 'mist' && 'bg-mist', tone === 'blue' && 'led-blue']} id={id}>
    <div class="wrap led-wrap">
      {(title || intro) && <div class="led-head">{title && <h2 class="h2">{title}</h2>}{intro && <p class="led-intro">{intro}</p>}</div>}
      <dl class:list={['led', compact && 'is-compact']}>
        {rows.map((r) => <div class="led-row"><dt>{r.term}</dt><dd><DepthText text={r.body} />{r.note && <span class="led-note">{r.note}</span>}</dd></div>)}
      </dl>
    </div>
  </section>
) : (
  <dl class:list={['led', compact && 'is-compact']}>
    {rows.map((r) => <div class="led-row"><dt>{r.term}</dt><dd><DepthText text={r.body} />{r.note && <span class="led-note">{r.note}</span>}</dd></div>)}
  </dl>
)}
<style>
  .led-blue { background: var(--blue-100); }
  .led-wrap { display: grid; gap: clamp(1.2rem, 1rem + 1.5vw, 2.2rem); }
  @media (min-width: 1000px) { .led-wrap:has(.led-head) { grid-template-columns: minmax(0, .8fr) minmax(0, 1.6fr); align-items: start; } .led-head { position: sticky; top: 110px; } }
  .led-head { display: grid; gap: .8rem; }
  .led-intro { font-size: 1.15rem; color: var(--ink-2); max-width: 46ch; }
  .led { margin: 0; border-top: 2px solid var(--navy); }
  .led-row { display: grid; gap: .3rem 2rem; padding: 1.15rem 0; border-bottom: 1px solid var(--line-strong); }
  @media (min-width: 700px) { .led-row { grid-template-columns: minmax(0, 13rem) minmax(0, 1fr); } }
  .led dt { font-family: var(--font-display); font-weight: 850; font-size: 1.18rem; color: var(--navy); line-height: 1.25; }
  .led dd { margin: 0; font-size: 1.12rem; line-height: 1.6; color: var(--ink-2); max-width: 64ch; }
  .led dd :global(a) { font-weight: 700; }
  .led-note { display: block; margin-top: .35rem; font-size: 1rem; color: var(--ink-3); }
  @media (max-width: 699px) { .led-row { padding: .85rem 0; } .led dt { font-size: 1.1rem; } .led dd { font-size: 1.05rem; line-height: 1.5; } }
  .is-compact .led-row { padding: .8rem 0; }
  .is-compact dt { font-size: 1.08rem; }
</style>
