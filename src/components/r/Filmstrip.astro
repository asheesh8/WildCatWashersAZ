---
/**
 * Job photos at (nearly) their own shape, in one justified row: each photo's width
 * follows its ratio, so a portrait shot stays portrait and a wide one stays wide.
 * Ratios are clamped to 0.7–1.6 (a little crop at the extremes only).
 * Phones: one swipe row of fixed height. Captions name the work and the town.
 * A lone photo is not a strip, so fewer than two leaves the section out.
 */
import { Image } from 'astro:assets';
import { img, altFor, focusFor, hasImg, sceneOf, ratioOf, captionFor } from '@/data/media';
export interface Props { keys: string[]; title?: string; avoid?: string[]; max?: number; tone?: 'plain' | 'mist'; caption?: boolean; label?: string }
const { keys, title, avoid = [], max = 4, tone = 'plain', caption = true, label } = Astro.props;
const seen = new Set<string>(avoid.filter(Boolean).map(sceneOf));
const list = keys.filter((k) => hasImg(k) && !seen.has(sceneOf(k)) && seen.add(sceneOf(k))).slice(0, max);
/* Two photos from the same job would share a caption; only the first one says it. */
const said = new Set<string>();
const cap = (k: string) => { const c = captionFor(k); if (!c || said.has(c)) return undefined; said.add(c); return c; };
const r = (k: string) => Math.min(1.6, Math.max(0.7, ratioOf(k)));
---
{list.length > 1 && (
  <section class:list={['section-tight fs', tone === 'mist' && 'bg-mist']} aria-label={title ? undefined : (label ?? 'Photos from our jobs')}>
    <div class="wrap">
      {title && <h2 class="h3 fs-title">{title}</h2>}
      <ul class="fs-row" role="list">
        {list.map((k) => (
          <li style={`--r:${r(k).toFixed(3)}`}>
            <figure>
              <div class="fs-frame"><Image src={img(k)} alt={altFor(k)} widths={[300, 480, 720]} sizes="(min-width: 1000px) 30vw, 60vw" loading="lazy" decoding="async" quality={68} style={`object-position:${focusFor(k)}`} /></div>
              {caption && (() => { const c = cap(k); return c && <figcaption>{c}</figcaption>; })()}
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
<style>
  .fs-title { margin-bottom: 1.1rem; }
  .fs-row { list-style: none; padding: 0; display: flex; gap: .9rem; align-items: flex-start; }
  .fs-row li { flex: var(--r) 1 0; min-width: 0; }
  .fs-row figure { margin: 0; }
  .fs-frame { aspect-ratio: var(--r); overflow: hidden; border-radius: var(--radius); background: var(--blue-50); }
  .fs-frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  figcaption { margin-top: .5rem; font-size: 1rem; color: var(--ink-3); font-weight: 600; line-height: 1.3; }
  @media (max-width: 759px) {
    .fs-row { overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); scrollbar-width: none; gap: .7rem; }
    .fs-row::-webkit-scrollbar { display: none; }
    .fs-row li { flex: none; width: calc(250px * var(--r)); max-width: 82vw; scroll-snap-align: start; }
  }
</style>
