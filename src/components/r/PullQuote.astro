---
/** One real review set large: the words are the design. Exact text, name as published, place and platform. */
import type { Review } from '@/data/reviews';
import { displayName, placeLabel } from '@/data/reviews';
export interface Props { review: Review; tone?: 'blue' | 'plain' | 'mist'; heading?: string; max?: number }
const { review: r, tone = 'blue', heading, max = 340 } = Astro.props;
/* Long reviews are cut at a sentence end and marked, never reworded. */
let text = r.text;
if (text.length > max) {
  const cut = text.slice(0, max);
  const end = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('! '));
  text = (end > 80 ? cut.slice(0, end + 1) : cut.replace(/\s+\S*$/, '')) + ' …';
}
const place = placeLabel(r);
---
<section class:list={['pq', `pq-${tone}`]}>
  <div class="wrap pq-wrap">
    {heading && <h2 class="h3 pq-h">{heading}</h2>}
    <figure>
      <span class="stars pq-stars" role="img" aria-label="Five stars">★★★★★</span>
      <blockquote><p>“{text}”</p></blockquote>
      <figcaption><strong>{displayName(r)}</strong>{place && <span>{place}</span>}<span>{/review$/i.test(r.platform) ? r.platform : `${r.platform} review`}</span></figcaption>
    </figure>
  </div>
</section>
<style>
  .pq { padding-block: clamp(2.6rem, 2rem + 3vw, 5rem); }
  .pq-blue { background: var(--blue); color: var(--navy); }
  .pq-mist { background: var(--mist); }
  .pq-wrap { display: grid; gap: 1rem; max-width: 980px; }
  .pq-h { color: inherit; }
  figure { margin: 0; display: grid; gap: 1.1rem; }
  .pq-blue .pq-stars { color: var(--navy); }
  blockquote { margin: 0; }
  blockquote p { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.45rem, 1.1rem + 1.6vw, 2.3rem); line-height: 1.28; letter-spacing: -0.01em; color: var(--navy); text-wrap: pretty; }
  @media (max-width: 759px) {
    /* Phones: the quote stays the loudest thing in its section without taking a whole screen. */
    .pq { padding-block: 1.9rem; }
    blockquote p { font-size: 1.22rem; line-height: 1.34; }
  }
  /* Inline with a dot that stays on the line it ends, so a wrap never starts a line with a dot. */
  figcaption { font-size: 1.08rem; line-height: 1.5; color: var(--ink-2); }
  .pq-blue figcaption { color: var(--navy); }
  figcaption strong { font-family: var(--font-display); font-weight: 850; color: var(--navy); }
  figcaption strong + span::before, figcaption span + span::before { content: '\00a0\00a0·\00a0 '; opacity: .6; }
</style>
