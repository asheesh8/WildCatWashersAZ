---
/** Hero lede. Phones show three lines of a long answer, then "Read the full answer";
    the clamp is in the HTML from first paint so late fonts can't move the page. */
export interface Props { text?: string; id?: string; clampAt?: number; class?: string }
const { text, id = 'hero-lede', clampAt = 200, class: cls } = Astro.props;
const clamp = Boolean(text && text.length > clampAt);
---
{text && <p class:list={['hlede', clamp && 'is-clamp', cls]} id={id}>{text}</p>}
{clamp && (
  <button type="button" class="hlede-more" aria-expanded="false" aria-controls={id} data-lede-more={id}>Read the full answer</button>
  <script is:inline define:vars={{ id }}>
    (function () {
      var b = document.querySelector('[data-lede-more="' + id + '"]'), p = document.getElementById(id);
      if (!b || !p) return;
      b.addEventListener('click', function () { p.classList.remove('is-clamp'); b.remove(); p.setAttribute('tabindex', '-1'); p.focus(); });
    })();
  </script>
)}
<style>
  .hlede { font-size: var(--step-1); line-height: 1.5; color: var(--ink-2); max-width: 54ch; }
  @media (max-width: 699px) { .hlede { font-size: 1.12rem; line-height: 1.55; } }
  .hlede-more { display: none; }
  @media (max-width: 759px) {
    :global(.js) .hlede.is-clamp { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    :global(.js) .hlede-more { all: unset; cursor: pointer; font-weight: 700; color: var(--blue-700); text-decoration: underline; text-underline-offset: 3px; min-height: 44px; display: inline-flex; align-items: center; margin-top: -.5rem; }
    .hlede-more:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; border-radius: 4px; }
  }
</style>
