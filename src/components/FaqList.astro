---
/** Plain details/summary FAQ; the page adds FAQPage JSON-LD from the same list. */
import type { Faq } from '@/data/faq';
export interface Props { items: Faq[]; title?: string; eyebrow?: string; id?: string; /** Question number → the page that owns it, for a "more on this" link. */ links?: Record<number, { href: string; label: string }>; /** Open the first answer (off where the page must stay short on phones). */ openFirst?: boolean; /** Phones only: the first answer starts closed too (town, community and service-town pages). */ phoneClosed?: boolean; /** Phones: the whole FAQ folds to its heading. */ mfold?: boolean }
const { items, title = 'Questions people ask us', eyebrow = 'FAQ', id = 'faq', links = {}, openFirst = true, phoneClosed = false, mfold = false } = Astro.props;
// Phones: past five questions, the rest wait behind a "Show more questions" button (all stay in the HTML and the FAQ schema).
const PHONE_LIMIT = 5;
const extra = items.length > PHONE_LIMIT + 1 ? items.length - PHONE_LIMIT : 0;
---
<section class="section" aria-labelledby={`${id}-title`} data-mfold={mfold ? '' : undefined}>
  <div class="wrap-narrow">
    <div class="section-head center">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={`${id}-title`} class="h2 sweep">{title}</h2>
    </div>
    <div class="faq">
      {items.map((f, i) => (
        <details open={openFirst && i === 0} class:list={[extra && i >= PHONE_LIMIT && 'faq-x']}>
          <summary><span>{f.q}</span><span class="plus" aria-hidden="true"></span></summary>
          <div class="faq-a"><p>{f.a}</p>{links[f.n] && <a class="faq-more" href={links[f.n].href}>{links[f.n].label}</a>}</div>
        </details>
      ))}
    </div>
    {phoneClosed && openFirst && (
      <script is:inline>
        (function () {
          var l = document.currentScript && document.currentScript.previousElementSibling, d = l && l.querySelector('details');
          if (d && matchMedia('(max-width: 759px)').matches) d.open = false;
        })();
      </script>
    )}
    {extra > 0 && (
      <button type="button" class="faq-all" aria-expanded="false" data-faq-all>Show {extra} more questions</button>
    )}
    <slot />
  </div>
</section>
<style>
  .faq { display: grid; gap: .7rem; }
  details { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); transition: border-color .2s, box-shadow .25s var(--ease); }
  details:hover { border-color: var(--blue-200); }
  details[open] { border-color: var(--blue); box-shadow: 0 0 0 1px var(--blue), var(--shadow-sm); }
  summary {
    list-style: none; cursor: pointer; display: flex; gap: 1rem; align-items: center; justify-content: space-between;
    padding: 1.2rem 1.3rem; font-family: var(--font-display); font-weight: 800; font-size: clamp(1.15rem, 1.05rem + .4vw, 1.35rem); color: var(--navy); line-height: 1.25;
  }
  summary::-webkit-details-marker { display: none; }
  .plus { position: relative; flex: none; width: 40px; height: 40px; border-radius: 50%; background: var(--blue-50); }
  .plus::before, .plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 16px; height: 3px; border-radius: 3px; background: var(--navy); translate: -50% -50%; transition: rotate .25s var(--ease); }
  .plus::after { rotate: 90deg; }
  details[open] .plus { background: var(--blue); }
  details[open] .plus::after { rotate: 0deg; }
  .faq-a { padding: 0 1.3rem 1.3rem; }
  .faq-more { display: inline-block; margin-top: .6rem; font-weight: 700; }
  .faq-a p { font-size: 1.12rem; color: var(--ink-2); max-width: 64ch; }
  summary:active .plus { transform: scale(.92); }
  .plus { transition: transform .15s var(--ease-press), background .2s; }
  @media (max-width: 699px) {
    .faq { gap: .6rem; }
    summary { padding: 1rem 1.1rem; font-size: 1.12rem; }
    .plus { width: 36px; height: 36px; }
    .faq-a { padding: 0 1.1rem 1.1rem; }
  }
  .faq-all { display: none; }
  .faq-all[hidden] { display: none !important; }
  @media (max-width: 759px) {
    :global(.js) .faq:not(.is-all) .faq-x { display: none; }
    :global(.js) .faq-all { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 48px; margin-top: .8rem; padding: .7rem 1rem; border: 1.5px solid var(--line); border-radius: var(--radius); background: #fff; color: var(--navy); font-weight: 700; font-size: 1.02rem; }
  }
  @media (prefers-reduced-motion: reduce) { .plus, .plus::before, .plus::after { transition: none; } summary:active .plus { transform: none; } }
</style>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-faq-all]').forEach((b) => {
    b.addEventListener('click', () => {
      const list = b.parentElement?.querySelector('.faq');
      if (!list) return;
      list.classList.add('is-all');
      b.setAttribute('aria-expanded', 'true');
      b.hidden = true;
      list.querySelector<HTMLElement>('.faq-x summary')?.focus();
    });
  });
</script>
