---
import Icon from './Icon.astro';
import { proof } from '@/data/business';
const items: { icon: string; text: string; href?: string }[] = [
  { icon: 'star', text: `${proof.reviews} five-star reviews` },
  { icon: 'award', text: '2026 AZ Daily Star Readers’ Choice Winner', href: '/awards/' },
  { icon: 'shield', text: 'You don’t pay until you’re happy' },
  { icon: 'calendar', text: '14-Day Spotless Guarantee' },
];
---
<div class="trow">
  <ul class="wrap" role="list">
    {items.map((i) => <li><span class="ti"><Icon name={i.icon} size={20} /></span>{i.href ? <a href={i.href}>{i.text}</a> : i.text}</li>)}
  </ul>
</div>
<style>
  .trow { background: var(--navy); color: #fff; }
  .trow ul { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: .8rem 1.2rem; padding-block: 1.1rem; }
  @media (min-width: 900px) { .trow ul { grid-template-columns: repeat(4, auto); justify-content: space-between; } }
  .trow li { display: flex; align-items: center; gap: .6rem; font-weight: 700; font-size: 1.02rem; line-height: 1.25; }
  .trow a { color: inherit; text-decoration: underline; text-decoration-color: var(--blue); text-underline-offset: 3px; }
  @media (max-width: 759px) { .trow ul { gap: .55rem .9rem; padding-block: .8rem; } .trow li { font-size: .92rem; gap: .5rem; } .trow .ti { width: 28px; height: 28px; } }
  .ti { width: 34px; height: 34px; flex: none; border-radius: 50%; display: grid; place-items: center; background: var(--blue); color: var(--navy); }
</style>
