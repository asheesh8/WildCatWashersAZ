---
/**
 * The Wildcat Promise: an ownable, certificate-style trust asset in the spirit
 * of Pink's Promise (Doc 7), signed by the founders, with the two guarantees
 * beside it.
 */
import Icon from './Icon.astro';
import { promise, guarantees, company } from '@/data/business';
export interface Props { showGuarantees?: boolean; headingLevel?: 'h1' | 'h2'; /** Phones: start each promise as its title only (home page). */ collapse?: boolean }
const { showGuarantees = true, headingLevel = 'h2', collapse = false } = Astro.props;
const H = headingLevel;
---
<section class="section promise-sec" aria-labelledby="promise-title">
  <div class="wrap promise-grid">
    <article class="cert reveal">
      <div class="cert-inner">
        <img class="cert-seal" src="/brand/wildcat-mascot.webp" alt="" width="120" height="120" loading="lazy" />
        <p class="cert-kicker">Our word, in writing</p>
        <H id="promise-title" class="cert-title">The Wildcat <span>Promise</span></H>
        <ol class:list={['cert-list', collapse && 'is-collapsible']} role="list">
          {promise.map((p, i) => (
            <li>
              <span class="cert-n" aria-hidden="true">{i + 1}</span>
              {collapse ? (
                <details open>
                  <summary><strong>{p.title}</strong><span class="cert-plus" aria-hidden="true"></span></summary>
                  <p>{p.body}</p>
                </details>
              ) : (
                <div><strong>{p.title}</strong><p>{p.body}</p></div>
              )}
            </li>
          ))}
        </ol>
        {collapse && <script is:inline>
          /* Phones: the five promises start as titles; tap one to read it. */
          (function () {
            var s = document.currentScript, l = s && s.previousElementSibling;
            if (!l) return;
            var phone = matchMedia('(max-width: 759px)').matches;
            l.querySelectorAll('details').forEach(function (d) {
              if (phone) d.open = false; else d.querySelector('summary').tabIndex = -1;
            });
          })();
        </script>}
        <div class="cert-sign">
          {company.founders.map((f) => (
            <div><span class="sig">{f}</span><span class="sig-role">{f}, Co-founder</span></div>
          ))}
        </div>
      </div>
    </article>
    {showGuarantees && (
      <div class="guar">
        <p class="eyebrow">Two guarantees on every job</p>
        {collapse ? (
          <div class="guar-row is-collapsible">
          {guarantees.map((g, i) => (
            <details class="guar-card guar-fold reveal" open>
              <summary>
                <span class="guar-icon"><Icon name={i === 0 ? 'shield' : 'calendar'} size={30} /></span>
                <h3 class="h3">{g.name}</h3>
                <p class="guar-head">{g.headline}</p>
                <span class="cert-plus" aria-hidden="true"></span>
              </summary>
              <p>{g.body}</p>
            </details>
          ))}
          </div>
        ) : (
          <div class="guar-row m-swipe">
          {guarantees.map((g, i) => (
            <div class="guar-card reveal">
              <span class="guar-icon"><Icon name={i === 0 ? 'shield' : 'calendar'} size={30} /></span>
              <h3 class="h3">{g.name}</h3>
              <p class="guar-head">{g.headline}</p>
              <p>{g.body}</p>
            </div>
          ))}
          </div>
        )}
        {collapse && <script is:inline>
          /* Phones: each guarantee starts as its name and headline; tap for the details. */
          (function () {
            var s = document.currentScript, l = s && s.previousElementSibling;
            if (!l) return;
            var phone = matchMedia('(max-width: 759px)').matches;
            l.querySelectorAll('details').forEach(function (d) {
              if (phone) d.open = false; else d.querySelector('summary').tabIndex = -1;
            });
          })();
        </script>}
        <a class="text-link" href="/guarantee/">How our guarantees work <Icon name="arrow" size={20} /></a>
      </div>
    )}
  </div>
</section>

<style>
  .promise-sec { background: var(--mist); }
  .promise-grid { display: grid; gap: clamp(2rem, 1rem + 3vw, 4rem); align-items: start; }
  @media (min-width: 1000px) { .promise-grid { grid-template-columns: 1.25fr .9fr; } }
  .cert {
    background: #fff; border-radius: 8px; padding: 12px;
    box-shadow: var(--shadow-lg);
    background-image: repeating-linear-gradient(45deg, var(--blue-50) 0 10px, #fff 10px 20px);
  }
  .cert-inner {
    position: relative; background: #fffdf8; border: 3px double var(--blue-600); border-radius: 4px;
    padding: clamp(1.6rem, 1rem + 3vw, 3.4rem) clamp(1.2rem, .8rem + 3vw, 3.4rem);
    text-align: center;
  }
  .cert-seal { width: 104px; height: 104px; margin: -4.8rem auto .6rem; border-radius: 50%; background: #fff; border: 4px solid var(--blue); padding: 6px; box-shadow: var(--shadow); }
  .cert-kicker { font-family: var(--font-script); color: var(--red); font-size: 1.8rem; }
  .cert-title { font-family: var(--font-display); font-weight: 900; text-transform: uppercase; font-size: clamp(2.2rem, 1.6rem + 3vw, 4rem); line-height: .95; color: var(--navy); font-variation-settings: 'wdth' 112; margin: .2rem 0 1.6rem; }
  .cert-title span { color: transparent; -webkit-text-stroke: 2px var(--navy); }
  .cert-list { list-style: none; padding: 0; display: grid; gap: 1.1rem; text-align: left; max-width: 620px; margin-inline: auto; }
  .cert-list li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; }
  .cert-n { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: var(--blue); color: var(--navy); font-family: var(--font-display); font-weight: 900; font-size: 1.2rem; }
  .cert-list strong { font-family: var(--font-display); font-weight: 800; font-size: 1.25rem; color: var(--navy); line-height: 1.3; }
  .cert-list p { color: var(--ink-2); font-size: 1.08rem; }
  .cert-list summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: .8rem; min-height: 44px; cursor: default; }
  .cert-list summary::-webkit-details-marker { display: none; }
  .cert-plus { display: none; }
  /* Desktop shows every promise in full; the rows aren't toggles there. */
  @media (min-width: 760px) { .cert-list summary { pointer-events: none; min-height: 0; } }
  .cert-list summary strong { display: block; }
  .cert-sign { display: flex; justify-content: center; flex-wrap: wrap; gap: 1rem 3rem; margin-top: 2.2rem; }
  .cert-sign div { display: grid; justify-items: center; }
  .sig { font-family: var(--font-script); font-size: 2.1rem; color: var(--navy); padding: 0 .6rem; border-bottom: 2px solid var(--navy); line-height: 1.3; }
  .sig-role { font-size: 1rem; color: var(--ink-3); margin-top: .35rem; font-weight: 650; }
  .guar { display: grid; gap: 1.1rem; }
  .guar-card { background: #fff; border-radius: var(--radius-lg); padding: 1.5rem; border: 1px solid var(--line); box-shadow: var(--shadow-sm); display: grid; grid-template-columns: auto 1fr; gap: .5rem 1rem; align-items: center; }
  .guar-card > :not(.guar-icon, .h3) { grid-column: 1 / -1; }
  .guar-icon { width: 52px; height: 52px; border-radius: var(--radius-sm); display: grid; place-items: center; background: var(--blue); color: var(--navy); }
  .guar-head { font-weight: 750; font-size: 1.2rem; color: var(--navy); }
  .guar-card p:last-child { color: var(--ink-2); }
  .guar-row { display: grid; gap: 1.1rem; }
  /* Folding guarantee cards (home): the same card, its summary holding the icon, name and headline. */
  .guar-fold { display: block; }
  .guar-fold summary { list-style: none; display: grid; grid-template-columns: auto 1fr; gap: .5rem 1rem; align-items: center; }
  .guar-fold summary::-webkit-details-marker { display: none; }
  .guar-fold summary:hover { color: inherit; }
  .guar-fold summary .guar-head { grid-column: 1 / -1; }
  .guar-fold > p { color: var(--ink-2); margin-top: .5rem; }
  @media (min-width: 760px) { .guar-fold summary { pointer-events: none; } }
  @media (max-width: 759px) {
    .cert { padding: 8px; }
    .cert-inner { padding: 1.4rem 1.1rem; }
    .cert-seal { width: 84px; height: 84px; margin-top: -3.6rem; }
    .cert-title { margin-bottom: 1.1rem; font-size: 2rem; }
    .cert-list { gap: .8rem; }
    .is-collapsible { gap: .35rem; }
    .is-collapsible li { align-items: center; gap: .8rem; }
    .is-collapsible li:has(details[open]) { align-items: start; }
    .is-collapsible li:has(details[open]) .cert-n { margin-top: .1rem; }
    .is-collapsible summary { pointer-events: auto; min-height: 44px; cursor: pointer; padding-block: .25rem; }
    .is-collapsible strong { font-size: 1.15rem; }
    .is-collapsible p { padding: 0 0 .5rem; }
    .is-collapsible .cert-n { width: 38px; height: 38px; font-size: 1.1rem; }
    .is-collapsible .cert-plus { display: block; position: relative; flex: none; width: 32px; height: 32px; border-radius: 50%; background: var(--blue-50); }
    .cert-plus::before, .cert-plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 13px; height: 2.5px; border-radius: 2px; background: var(--navy); translate: -50% -50%; transition: rotate .25s var(--ease); }
    .cert-plus::after { rotate: 90deg; }
    details[open] .cert-plus { background: var(--blue); }
    details[open] .cert-plus::after { rotate: 0deg; }
    .guar-row.is-collapsible { gap: .7rem; }
    .guar-fold { padding: 1rem 1.1rem; }
    .guar-fold summary { grid-template-columns: auto 1fr auto; gap: .35rem .8rem; cursor: pointer; }
    .guar-fold summary .guar-icon { width: 44px; height: 44px; }
    .guar-fold summary .h3 { font-size: 1.2rem; }
    .guar-fold summary .guar-head { font-size: 1.08rem; }
    .guar-fold summary .h3 { grid-column: 2 / -1; }
    .guar-fold summary .guar-head { grid-row: 2; grid-column: 1 / 3; }
    .guar-fold .cert-plus { display: block; grid-column: 3; grid-row: 2; align-self: end; position: relative; width: 32px; height: 32px; border-radius: 50%; background: var(--blue-50); }
    /* Phones: the two signatures sit side by side instead of stacking. */
    .cert-sign { margin-top: 1.4rem; gap: .8rem; flex-wrap: nowrap; }
    .cert-sign div { flex: 1 1 0; min-width: 0; }
    .sig { font-size: 1.45rem; padding: 0 .2rem; white-space: nowrap; }
    .sig-role { line-height: 1.35; }
  }
  @media (prefers-reduced-motion: reduce) { .cert-plus::before, .cert-plus::after { transition: none; } }
</style>
