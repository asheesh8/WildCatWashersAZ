---
/** Light-blue "home turf" band: a slow town-name marquee over a clear list. */
import Icon from './Icon.astro';
import { towns, townHref } from '@/data/areas';
export interface Props { title?: string }
const { title = 'Southern Arizona is our home turf' } = Astro.props;
const names = towns.map((t) => t.name);
---
<section class="turf" aria-labelledby="turf-title">
  <div class="turf-marquee" aria-hidden="true">
    <div class="turf-track">
      {[0, 1].map(() => names.map((n, i) => <span class:list={[i % 2 && 'o']}>{n}</span>))}
    </div>
  </div>
  <div class="wrap turf-grid">
    <div class="turf-head">
      <p class="eyebrow">Where we work</p>
      <h2 id="turf-title" class="h2 sweep">{title}</h2>
      <p class="lede">Based in Tucson and out across the metro seven days a week, from SaddleBrooke to Tubac. If you’re nearby and don’t see your town, call. We probably cover it.</p>
      <a class="btn btn-lg" href="/areas/"><span>See every area we serve</span><span class="chip"><Icon name="arrow" /></span></a>
    </div>
    <ul class="turf-list" role="list">
      {towns.map((t) => (
        <li><a href={townHref(t.slug)}><Icon name="pin" size={20} /><span>{t.name}</span><Icon name="arrow" size={20} class="go" /></a></li>
      ))}
    </ul>
  </div>
</section>
<style>
  .turf { background: var(--blue); color: var(--navy); padding-bottom: var(--section); overflow: hidden; }
  .turf-marquee { padding: 1.6rem 0 clamp(2rem, 1.5rem + 3vw, 4rem); }
  .turf-track { display: flex; gap: 2.4rem; width: max-content; animation: turf 80s linear infinite; }
  .turf-track span { font-family: var(--font-display); font-weight: 900; text-transform: uppercase; font-size: clamp(2.6rem, 2rem + 3vw, 5rem); line-height: 1; white-space: nowrap; color: rgb(18 24 50 / 14%); }
  .turf-track span.o { color: transparent; -webkit-text-stroke: 2px rgb(18 24 50 / 22%); }
  @keyframes turf { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .turf-track { animation: none; } }
  .turf-grid { display: grid; gap: 2.4rem; }
  @media (min-width: 1000px) { .turf-grid { grid-template-columns: 1fr 1.1fr; align-items: start; } }
  .turf-head { display: grid; gap: 1.1rem; justify-items: start; }
  .turf .eyebrow { color: var(--navy); }
  .turf-list { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.2rem; }
  @media (max-width: 480px) { .turf-list { grid-template-columns: 1fr; } }
  .turf-list a { display: flex; align-items: center; gap: .6rem; padding: .85rem .2rem; border-bottom: 2px solid rgb(18 24 50 / 16%); text-decoration: none; font-weight: 750; font-size: 1.15rem; }
  .turf-list a span { flex: 1; }
  .turf-list a :global(.go) { transition: transform .25s var(--ease); }
  .turf-list a:hover :global(.go) { transform: translateX(4px); }
</style>
