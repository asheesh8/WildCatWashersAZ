---
/** Inner-page hero: light blue, big type, one CTA, the phone number, and a photo. */
import { Image, getImage } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';
import LoopVideo from './LoopVideo.astro';
import { img, altFor, hasImg, focusFor, cropFor, bandFor } from '@/data/media';
import { company, cta, telHref, proof } from '@/data/business';
export interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  crumbs?: { name: string; href: string }[];
  image?: string;
  ctaLabel?: string;
  ctaHref?: string;
  rating?: boolean;
  /** A loop from src/data/videos.ts, shown in place of the photo. */
  video?: string;
}
const { eyebrow, title, lede, crumbs = [], image, ctaLabel = cta.primary, ctaHref = cta.quoteHref, rating = true, video } = Astro.props;
const photo = image && hasImg(image) ? img(image) : null;
/* The photo is cropped at build time to the 4:3.3 frame (anchored on its focus),
   so the frame shows it whole on desktop. On phones the frame is a wider band;
   re-aim object-position so the band shows the same slice of the photo it
   showed before the crop (a band about 0.62 of its width tall). */
const heroPos = (() => {
  if (!photo || !image) return '';
  const [x, y] = focusFor(image).split(/\s+/).map((v) => parseFloat(v) / 100);
  const h0 = photo.height / photo.width, hc = 3.3 / 4, band = 0.62;
  if (h0 <= hc) return focusFor(image);
  const pos = cropFor(image);
  const c = pos.includes('top') ? 0 : pos.includes('bottom') ? h0 - hc : (h0 - hc) / 2;
  const p = Math.min(1, Math.max(0, (y * (h0 - band) - c) / (hc - band)));
  return `${Math.round(x * 100)}% ${Math.round(p * 100)}%`;
})();
/* Short H1s stay as bold uppercase headlines; longer or question H1s read as
   sentences, so they fit in four lines on a phone (design review 1). */
/* Phones and tablets show the photo as a wide band (about 16:9 or wider), so they get
   their own 16:9 crop instead of downloading the 4:3.3 one and hiding a third of it. */
const band = photo && image
  ? await Promise.all([480, 640, 720, 800, 960].map((w) => getImage({ src: photo, width: w, height: Math.round(w * 9 / 16), fit: 'cover', position: bandFor(image), format: 'webp', quality: 66 })))
  : [];
const bandSrcset = band.map((b, i) => `${b.src} ${[480, 640, 720, 800, 960][i]}w`).join(', ');
const long = title.trim().split(/\s+/).length > 5 || title.trim().endsWith('?');
---
<section class:list={['phero', (photo || video) && 'has-photo']}>
  <div class="wrap phero-grid">
    <div class="phero-copy">
      {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
      {rating && (
        <p class="pill"><span class="stars" aria-hidden="true">★★★★★</span><span>{proof.reviews} five-star reviews</span></p>
      )}
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class:list={['h1 sweep', long && 'is-long']}>{title.split(/(5-in-1)/).map((part) => part === '5-in-1' ? <span class="nowrap">{part}</span> : part)}</h1>
      {lede && <p class="lede" id="phero-lede">{lede}</p>}
      {lede && lede.length > 200 && (
        <script is:inline>
          /* Phones: a long answer shows three lines, then "Read the full answer". The text stays in the page. */
          (function () {
            var p = document.getElementById('phero-lede');
            if (!p || !matchMedia('(max-width: 759px)').matches) return;
            p.classList.add('is-clamp');
            if (p.scrollHeight <= p.clientHeight + 4) { p.classList.remove('is-clamp'); return; }
            var b = document.createElement('button');
            b.type = 'button'; b.className = 'lede-more'; b.textContent = 'Read the full answer';
            b.setAttribute('aria-expanded', 'false'); b.setAttribute('aria-controls', 'phero-lede');
            b.addEventListener('click', function () { p.classList.remove('is-clamp'); b.remove(); p.setAttribute('tabindex', '-1'); p.focus(); });
            p.after(b);
          })();
        </script>
      )}
      <slot />
      <div class="cta-row">
        <a class="btn btn-lg" href={ctaHref} data-track="quote-page-hero"><span>{ctaLabel}</span><span class="chip"><Icon name="arrow" /></span></a>
        <a class="phone-link" href={telHref} data-track="call-page-hero"><Icon name="phone" /><span>{company.phone}</span></a>
      </div>
    </div>
    {video && (
      <div class="phero-photo photo"><LoopVideo name={video} /></div>
    )}
    {!video && photo && (
      <div class="phero-photo photo">
        {/* Cropped at build time to the frame's 4:3.3, anchored on the photo's focus,
            so a portrait photo doesn't ship the half that object-fit would hide. */}
        <picture>
          <source media="(max-width: 999px)" type="image/webp" srcset={bandSrcset} sizes="calc(100vw - 2rem)" />
          <Image src={photo} alt={altFor(image!)} width={1200} height={990} fit="cover" position={cropFor(image!)} widths={[480, 640, 720, 800, 960, 1200]} sizes="(min-width: 1000px) 46vw, calc(100vw - 2rem)" loading="eager" fetchpriority="high" decoding="async" quality={66} style={`object-position:${heroPos};--fpos:${focusFor(image!)}`} />
        </picture>
      </div>
    )}
  </div>
</section>

<style>
  .phero {
    background: linear-gradient(180deg, var(--blue-100) 0%, var(--blue-50) 60%, #fff 100%);
    padding-top: calc(var(--header-h) * 0 + clamp(1.5rem, 1rem + 2vw, 3rem));
    padding-bottom: clamp(2.5rem, 2rem + 3vw, 5rem);
    overflow: hidden;
  }
  .phero-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(1.8rem, 1rem + 3vw, 3.5rem); align-items: center; }
  @media (min-width: 1000px) { .has-photo .phero-grid { grid-template-columns: 1.1fr 1fr; } .phero-photo { transform: rotate(1.2deg); } }
  .phero-copy { --stack-gap: 1.1rem; display: grid; gap: 1.1rem; justify-items: start; }
  .phero .h1 { font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3.1rem); max-width: 20ch; overflow-wrap: break-word; }
  .phero .h1.is-long { font-size: clamp(1.75rem, 1.25rem + 2vw, 2.9rem); text-transform: none; font-variation-settings: 'wdth' 100; letter-spacing: -0.01em; line-height: 1.08; max-width: 24ch; }
  .phero .lede { max-width: 52ch; }
  /* Phones: a calmer intro so the quote button stays near the first screen */
  @media (max-width: 699px) { .phero .lede { font-size: 1.1rem; line-height: 1.55; } }
  @media (max-width: 759px) { .phero .lede.is-clamp { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; } }
  :global(.lede-more) { all: unset; cursor: pointer; font-weight: 700; color: var(--blue-700); text-decoration: underline; text-underline-offset: 3px; min-height: 44px; display: inline-flex; align-items: center; }
  :global(.lede-more:focus-visible) { outline: 3px solid var(--blue); outline-offset: 2px; border-radius: 4px; }
  .nowrap { white-space: nowrap; }
  .phero-photo { aspect-ratio: 4 / 3.3; border: 6px solid #fff; }
  .phero-photo picture { display: contents; }
  .phero-photo :global(img), .phero-photo :global(.loop) { width: 100%; height: 100%; object-fit: cover; border-radius: 0; }
  /* Phones: the photo moves up under the headline, as a short band, so every
     inner page shows a real photo on its first screen. */
  @media (max-width: 999px) {
    .has-photo .phero-grid { gap: 0; --stack-gap: 1rem; }
    .has-photo .phero-copy { display: contents; }
    .has-photo .phero-grid > .phero-copy > * { order: 6; margin-bottom: 1rem; justify-self: start; }
    .has-photo .phero-grid > .phero-copy > :global(.crumbs) { order: 1; margin-bottom: .8rem; }
    .has-photo .phero-grid > .phero-copy > .pill { order: 2; }
    .has-photo .phero-grid > .phero-copy > .eyebrow { order: 3; }
    .has-photo .phero-grid > .phero-copy > .h1 { order: 4; }
    /* The band gets its own 16:9 crop (the <source> above), so aim it at the photo's focus. */
    .has-photo .phero-photo :global(img) { object-position: var(--fpos, 50% 50%) !important; }
    .has-photo .phero-photo { order: 5; aspect-ratio: auto; height: clamp(180px, 26vh, 240px); margin-bottom: 1.1rem; border-width: 4px; }
    /* The quote button sits right under the photo so it clears the bottom bar; the lede follows (DOM order unchanged). */
    .has-photo .phero-grid > .phero-copy > .cta-row { order: 6; margin-bottom: 1.1rem; }
    .has-photo .phero-grid > .phero-copy > .lede { order: 7; }
    .has-photo .phero-grid > .phero-copy > :global(.lede-more) { order: 8; margin-top: -.6rem; }
  }
  @media (max-width: 759px) {
    /* The last crumb repeats the H1; drop it on phones. */
    .phero :global(.crumbs li:last-child) { display: none; }
    /* The bottom bar already has Call, and the trust strip right below repeats the review count. */
    .phero .phone-link { display: none; }
    .phero:has(+ :global(.trow)) .pill { display: none; }
  }
  .cta-row { margin-top: .4rem; }
</style>
