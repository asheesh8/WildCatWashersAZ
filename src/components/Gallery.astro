---
import { Image } from 'astro:assets';
import { img, altFor, hasImg } from '@/data/media';
export interface Props { keys: string[]; title?: string }
const { keys, title } = Astro.props;
const list = keys.filter(hasImg).slice(0, 6);
---
{list.length > 0 && (
  <section class="section-tight" aria-label={title ?? 'Photos from our jobs'}>
    <div class="wrap">
      {title && <h2 class="h3" style="margin-bottom:1.2rem">{title}</h2>}
      <ul class="gal" role="list">
        {list.map((k) => (
          <li class="photo reveal"><Image src={img(k)} alt={altFor(k)} widths={[360, 560, 800]} sizes="(min-width: 1000px) 33vw, 50vw" quality={68} /></li>
        ))}
      </ul>
    </div>
  </section>
)}
<style>
  .gal { list-style: none; padding: 0; display: grid; gap: .8rem; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 900px) { .gal { grid-template-columns: repeat(3, 1fr); } }
  .gal li { aspect-ratio: 4 / 3; border-radius: var(--radius); }
  .gal li:first-child { grid-column: span 2; grid-row: span 2; aspect-ratio: auto; }
  .gal :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
