---
/**
 * Short quote form: name, phone, service, town, optional note. A form gets a
 * call back right away (C§), so the promise under the button is a phone call,
 * not a price by email.
 *
 * Where it posts: PUBLIC_QUOTE_ENDPOINT if set; Netlify Forms natively on
 * Netlify; otherwise /api/quote (api/quote.js, emails the office through Resend
 * on Vercel). If that fails or isn't configured, the submit handler never fakes
 * success: it shows a call/email fallback with the answers already written in.
 */
import Icon from './Icon.astro';
import { company, services, cta, telHref } from '@/data/business';
import { towns } from '@/data/areas';
export interface Props { service?: string; area?: string; id?: string }
const { service, area, id = 'quote-form' } = Astro.props;
const endpoint = import.meta.env.PUBLIC_QUOTE_ENDPOINT || '/api/quote';
/* Without JavaScript the form posts straight to the quote function, which redirects to
   /thank-you/. (On Netlify the script below switches it back to Netlify Forms.) */
const action = endpoint === '/api/quote' ? '/api/quote' : '/thank-you/';
const here = Astro.url.pathname;
---
<form
  class="qf" id={id} method="POST" action={action} name="quote"
  data-netlify="true" netlify-honeypot="company-website" data-quote-form
  data-endpoint={endpoint} data-email={company.email}
>
  <input type="hidden" name="form-name" value="quote" />
  <input type="hidden" name="t" value="" data-qf-t />
  <input type="hidden" name="page" value={here} data-qf-page />
  <p class="qf-hp" aria-hidden="true"><label>Leave this empty <input name="company-website" tabindex="-1" autocomplete="off" /></label></p>

  <div class="qf-grid">
    <div class="field">
      <label for={`${id}-name`}>Your name <span class="req" aria-hidden="true">*</span></label>
      <input id={`${id}-name`} name="name" type="text" required autocomplete="name" maxlength="100" />
    </div>
    <div class="field">
      <label for={`${id}-phone`}>Phone <span class="req" aria-hidden="true">*</span></label>
      <input id={`${id}-phone`} name="phone" type="tel" required autocomplete="tel" inputmode="tel" maxlength="40" />
    </div>
    <div class="field">
      <label for={`${id}-service`}>What can we clean?</label>
      <select id={`${id}-service`} name="service" data-qf-service>
        <option value="">Choose a service</option>
        {services.map((s) => <option value={s.slug} selected={s.slug === service}>{s.name}</option>)}
        <option value="multiple">More than one of these</option>
        <option value="commercial">A business or HOA property</option>
      </select>
    </div>
    <div class="field">
      <label for={`${id}-area`}>Your town</label>
      <select id={`${id}-area`} name="area" data-qf-area>
        <option value="">Choose your town</option>
        {towns.map((t) => <option value={t.slug} selected={t.slug === area}>{t.name}</option>)}
        <option value="other">Somewhere else nearby</option>
      </select>
    </div>
    <div class="field qf-full">
      <label for={`${id}-details`}>Anything we should know? <small>(optional)</small></label>
      <textarea id={`${id}-details`} name="details" rows="3" maxlength="2000"></textarea>
    </div>
  </div>

  <button type="submit" class="btn btn-lg btn-block btn-red"><span>{cta.primary}</span><span class="chip"><Icon name="arrow" /></span></button>
  <p class="qf-status" data-qf-status aria-live="polite"></p>
  <p class="qf-note"><Icon name="phone" size={18} /> {cta.responseLine}</p>

  <div class="qf-fallback" data-qf-fallback hidden role="alert">
    <p class="qf-fallback-head">Your quote request is ready.</p>
    <p>One last step: open the email below and press Send, or just give us a call.</p>
    <div class="qf-fallback-actions">
      <a class="phone-link" href={telHref}><Icon name="phone" /><span>{company.phone}</span></a>
      <a class="text-link" data-qf-mailto href={`mailto:${company.email}`}>Open the email</a>
    </div>
  </div>
</form>

<style>
  .qf { display: grid; gap: 1.1rem; scroll-margin-top: calc(var(--header-h, 80px) + 1rem); }
  .qf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .qf-full { grid-column: 1 / -1; }
  @media (max-width: 620px) { .qf-grid { grid-template-columns: 1fr; } }
  .field small { font-size: 1rem; font-weight: 500; color: var(--ink-3); }
  .qf-status:empty { display: none; }
  .qf-status { text-align: center; font-weight: 700; color: var(--navy); }
  .qf-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .qf-note { display: flex; gap: .5rem; align-items: center; justify-content: center; text-align: center; color: var(--ink-2); font-weight: 600; font-size: 1.02rem; }
  .qf-fallback { background: #fff8e6; border: 1px solid #f0d489; border-left: 5px solid #e0a800; border-radius: 12px; padding: 1rem 1.15rem; display: grid; gap: .5rem; color: #5b4500; }
  .qf-fallback[hidden] { display: none; }
  .qf-fallback-head { font-family: var(--font-display); font-weight: 800; }
  .qf-fallback-actions { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
</style>

<script is:inline>
  (() => {
    const params = new URLSearchParams(location.search);
    const onNetlify = /netlify\.app$/.test(location.hostname) || document.documentElement.dataset.netlify === 'true';
    document.querySelectorAll('[data-quote-form]').forEach((form) => {
      for (const [key, sel] of [['service', '[data-qf-service]'], ['area', '[data-qf-area]']]) {
        const v = params.get(key); const el = form.querySelector(sel);
        if (v && el && [...el.options].some((o) => o.value === v)) el.value = v;
      }
      /* Load time, so the server can drop submits that come too fast to be a person. */
      const t = form.querySelector('[data-qf-t]');
      if (t) t.value = String(Date.now());
      const phone = form.querySelector('input[name=phone]');
      if (phone) phone.addEventListener('input', () => phone.setCustomValidity(''));
      /* The page the visitor came from: the bar's ?from=, else a same-site referrer, else this page. */
      const pageIn = form.querySelector('[data-qf-page]');
      let from = params.get('from') || '';
      if (!/^\/[\w\-/]*$/.test(from)) from = '';
      if (!from && document.referrer) { try { const r = new URL(document.referrer); if (r.host === location.host && r.pathname !== location.pathname) from = r.pathname; } catch {} }
      if (pageIn) pageIn.value = from || location.pathname;
      const endpoint = form.dataset.endpoint || '';
      if (onNetlify && endpoint === '/api/quote') { form.setAttribute('action', '/thank-you/'); return; }
      const fallback = form.querySelector('[data-qf-fallback]');
      const mailto = form.querySelector('[data-qf-mailto]');
      form.addEventListener('submit', async (e) => {
        if (phone) phone.setCustomValidity(phone.value.replace(/\D/g, '').length < 7 ? 'Please enter a phone number we can call or text.' : '');
        if (!form.reportValidity()) { e.preventDefault(); return; }
        e.preventDefault();
        const data = new FormData(form);
        if (data.get('company-website')) return;
        const button = form.querySelector('button[type=submit]');
        if (button && button.disabled) return;
        const submit = button && button.querySelector('span');
        const status = form.querySelector('[data-qf-status]');
        const label = submit ? submit.textContent : '';
        if (submit) submit.textContent = 'Sending…';
        if (button) button.disabled = true;
        form.setAttribute('aria-busy', 'true');
        if (status) status.textContent = 'Sending your request…';
        const reset = () => {
          if (submit) submit.textContent = label;
          if (button) button.disabled = false;
          form.removeAttribute('aria-busy');
          if (status) status.textContent = '';
        };
        const showFallback = () => {
          const lines = ['name', 'phone', 'service', 'area', 'details'].map((k) => `${k}: ${data.get(k) || '-'}`).join('\n');
          if (mailto) mailto.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Quote request: ' + (data.get('name') || 'website'))}&body=${encodeURIComponent(lines)}`;
          if (fallback) { fallback.hidden = false; fallback.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); }
          reset();
        };
        try {
          const res = await fetch(endpoint, { method: 'POST', body: new URLSearchParams(data), headers: { Accept: 'application/json' } });
          if (res.status === 400) {
            reset();
            if (phone) { phone.setCustomValidity('Please enter a phone number we can call or text.'); form.reportValidity(); }
            return;
          }
          if (!res.ok) throw new Error(String(res.status));
          location.assign('/thank-you/');
        } catch {
          const h = fallback && fallback.querySelector('.qf-fallback-head');
          if (h) h.textContent = 'We couldn’t send that automatically.';
          showFallback();
        }
      });
    });
  })();
</script>
