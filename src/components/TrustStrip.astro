---
import { proof, awards, guarantees } from '@/data/business';
const stats = [
  { n: proof.customersServedLabel, l: 'homes & businesses cleaned' },
  { n: '5.0', l: 'stars — never a review below it' },
  { n: '8', l: 'towns across Greater Tucson' },
  { n: '14', l: 'day Spotless Guarantee' },
];
---
<section class="ts">
  <div class="wrap">
    <ul class="ts-stats">
      {stats.map((s) => (
        <li>
          <span class="ts-n">{s.n}</span>
          <span class="ts-l">{s.l}</span>
        </li>
      ))}
    </ul>
    <div class="ts-awards">
      <p class="ts-awards-lbl">Recognised by</p>
      <ul>
        {awards.map((a) => (
          <li>
            <strong>{a.short}</strong>
            {a.year && <span>{a.year}</span>}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .ts { background: var(--surface); border-bottom: 1px solid var(--line); padding-block: clamp(2rem, 4vw, 3rem); }
  .ts-stats {
    list-style: none; margin: 0 0 2rem; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem;
  }
  .ts-stats li { display: grid; gap: .15rem; padding-left: 1.1rem; border-left: 3px solid var(--cyan); }
  .ts-n { font-family: var(--font-display); font-weight: 900; font-size: clamp(1.9rem, 4vw, 2.9rem); line-height: 1; letter-spacing: -.04em; color: var(--navy); }
  .ts-l { font-size: .92rem; color: var(--ink-3); line-height: 1.35; font-weight: 500; }

  .ts-awards { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.1rem; padding-top: 1.75rem; border-top: 1px solid var(--line-2); }
  .ts-awards-lbl { font-family: var(--font-display); font-size: .74rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-3); }
  .ts-awards ul { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; padding: 0; }
  .ts-awards li {
    display: inline-flex; align-items: baseline; gap: .4rem;
    padding: .42rem .9rem; border-radius: 999px;
    background: var(--surface-2); border: 1px solid var(--line);
    font-size: .87rem; color: var(--navy);
  }
  .ts-awards strong { font-family: var(--font-display); font-weight: 700; }
  .ts-awards span { color: var(--ink-3); font-size: .8rem; font-variant-numeric: tabular-nums; }

  @media (max-width: 820px) {
    .ts-stats { grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  }
</style>
