---
/** The light-blue closing band Cooper kept: outline type, a big phone number, and the form. */
import Icon from './Icon.astro';
import QuoteForm from './QuoteForm.astro';
import { company, telHref, guarantees } from '@/data/business';
export interface Props { service?: string; area?: string; place?: string }
const { service, area, place } = Astro.props;
---
<section class="shine" id="get-quote" aria-labelledby="shine-title">
  <div class="wrap shine-grid">
    <div class="shine-copy">
      <h2 id="shine-title" class="shine-title">
        <span class="l1">Let’s make</span>
        <span class:list={['l2', place && place.length > 12 && 'l2-long']}>{place ? `your ${place} home` : 'your place'}</span>
        <span class="l3 sweep">Shine</span>
      </h2>
      <p class="shine-lede">Call and we’ll quote most homes in a few minutes, right on the phone. Or send the form and we’ll call you right back.</p>
      <a class="shine-phone" href={telHref} data-track="call-shine"><span class="shine-phone-icon"><Icon name="phone" size={30} /></span>{company.phone}</a>
      <ul class="shine-g" role="list">
        {guarantees.map((g) => <li><Icon name="check-circle" size={24} />{g.name}</li>)}
        <li><Icon name="check-circle" size={24} />{company.availability}</li>
      </ul>
    </div>
    <a class="btn btn-lg btn-block shine-mbtn" href={`/quote/${service ? `?service=${service}` : ''}`}><span>Get my free quote online</span><span class="chip"><Icon name="arrow" /></span></a>
    <div class="shine-card">
      <p class="shine-card-title">Get your free quote</p>
      <QuoteForm service={service} area={area} id="shine-form" />
    </div>
  </div>
</section>

<style>
  .shine { background: var(--blue); color: var(--navy); padding-block: var(--section); position: relative; overflow: hidden; }
  .shine::before {
    content: ''; position: absolute; inset: auto -10% -40% auto; width: 60vw; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, rgb(255 255 255 / 35%), transparent 65%); pointer-events: none;
  }
  .shine-grid { position: relative; display: grid; gap: clamp(2rem, 1rem + 4vw, 4.5rem); align-items: center; }
  @media (min-width: 1000px) { .shine-grid { grid-template-columns: 1fr 1fr; } }
  .shine-title { font-family: var(--font-display); font-weight: 900; text-transform: uppercase; line-height: .9; letter-spacing: -.02em; font-variation-settings: 'wdth' 112; display: grid; }
  .l1, .l2 { font-size: clamp(2.3rem, 1.6rem + 3vw, 4.4rem); }
  .l2 { color: transparent; -webkit-text-stroke: 2px var(--navy); }
  .l2-long { font-size: clamp(1.6rem, 1.1rem + 2.4vw, 3.4rem); overflow-wrap: break-word; }
  .l3 { font-size: clamp(4.4rem, 2.6rem + 9vw, 10rem); color: #fff; text-shadow: 0 6px 0 var(--navy); line-height: .9; width: fit-content; }
  .shine-lede { font-size: var(--step-1); line-height: 1.45; margin: 1.4rem 0; max-width: 34ch; font-weight: 550; }
  .shine-phone {
    display: inline-flex; align-items: center; gap: .9rem; text-decoration: none; color: var(--navy);
    font-family: var(--font-display); font-weight: 900; font-size: clamp(2.1rem, 1.5rem + 3vw, 3.8rem); font-variation-settings: 'wdth' 105; letter-spacing: -.01em;
  }
  .shine-phone-icon { width: 1.4em; height: 1.4em; border-radius: 50%; display: grid; place-items: center; background: var(--navy); color: var(--blue); flex: none; font-size: .7em; }
  .shine-phone:hover { text-decoration: underline; text-decoration-thickness: 4px; }
  .shine-g { list-style: none; padding: 0; margin-top: 1.4rem; display: grid; gap: .5rem; font-weight: 700; font-size: 1.1rem; }
  .shine-g li { display: flex; align-items: center; gap: .6rem; }
  .shine-card { background: #fff; border-radius: calc(var(--radius-lg) + 4px); padding: clamp(1.3rem, 1rem + 2vw, 2.4rem); box-shadow: 0 30px 60px -24px rgb(18 24 50 / 45%); }
  .shine-card-title { font-family: var(--font-display); font-weight: 900; text-transform: uppercase; font-size: 1.7rem; margin-bottom: 1.2rem; color: var(--navy); }
  .shine-mbtn { display: none; }
  @media (max-width: 759px) {
    .shine-card { display: none; }
    .shine-mbtn { display: inline-flex; }
    .shine-grid { gap: 1.2rem; }
    .shine-lede { margin: 1rem 0; }
  }
</style>
