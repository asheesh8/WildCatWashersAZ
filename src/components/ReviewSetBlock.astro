---
import ReviewGrid from './ReviewGrid.astro';
import Icon from './Icon.astro';
import type { ReviewSet } from '@/lib/local';
export interface Props { set: ReviewSet; title: string }
const { set, title } = Astro.props;
// Phones: when a page has its own local reviews, the wider-area set waits behind a button (saves a full swipe row of scrolling).
const fold = set.local.length > 0 && set.more.length > 0;
---
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{set.count > 0 ? `${set.count} local review${set.count === 1 ? '' : 's'}` : 'Five-star reviews'}</p>
      <h2 class="h2 sweep">{title}</h2>
    </div>
    {set.local.length > 0 && (
      <>
        <p class="rs-label">{set.localLabel}</p>
        <ReviewGrid reviews={set.local} />
      </>
    )}
    {set.more.length > 0 && (
      <div id="rs-more" class:list={['rs-more', fold && 'is-fold']}>
        <p class="rs-label" style="margin-top:2rem">{set.moreLabel}</p>
        <ReviewGrid reviews={set.more} />
      </div>
    )}
    {fold && (
      <button type="button" class="rs-toggle" aria-expanded="false" aria-controls="rs-more">
        Show {set.more.length} more {set.moreLabel.charAt(0).toLowerCase() + set.moreLabel.slice(1)}
      </button>
    )}
    <p class="rs-all" style="margin-top:1.6rem"><a class="text-link" href="/reviews/">Read all our reviews <Icon name="arrow" size={20} /></a></p>
  </div>
</section>
<style>
  .rs-label { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; margin-bottom: 1rem; color: var(--navy); }
  .rs-toggle { display: none; }
  @media (max-width: 759px) {
    .rs-label { margin-bottom: .6rem; } .rs-all { margin-top: 1rem !important; }
    :global(.js) .rs-more.is-fold:not(.is-open) { display: none; }
    :global(.js) .rs-toggle { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 48px; margin-top: 1.2rem; padding: .7rem 1rem; border: 1.5px solid var(--line); border-radius: var(--radius); background: #fff; color: var(--navy); font-weight: 700; font-size: 1.02rem; text-align: center; }
  }
</style>
<script>
  document.querySelectorAll<HTMLButtonElement>('.rs-toggle').forEach((b) => {
    b.addEventListener('click', () => {
      const more = document.getElementById(b.getAttribute('aria-controls') || '');
      if (!more) return;
      more.classList.add('is-open');
      b.setAttribute('aria-expanded', 'true');
      b.hidden = true;
      // The swipe row was hidden when the page set up keyboard scrolling, so set it up now.
      const row = more.querySelector<HTMLElement>('.m-swipe');
      if (row && row.scrollWidth > row.clientWidth + 4 && row.tabIndex < 0) {
        row.tabIndex = 0;
        if (!/^(UL|OL)$/.test(row.tagName)) row.setAttribute('role', 'region');
        row.setAttribute('aria-label', 'More reviews, scrollable');
      }
      (more.querySelector('.rs-label') as HTMLElement | null)?.setAttribute('tabindex', '-1');
      (more.querySelector('.rs-label') as HTMLElement | null)?.focus();
    });
  });
</script>
