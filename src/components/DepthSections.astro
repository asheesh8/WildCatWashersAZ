---
/**
 * Local depth sections (src/data/depth.ts). "block" is a full-width section with
 * its own heading, used on town and community pages; "inline" is just the list,
 * for a column that already has a heading. Two columns from tablet.
 *
 * Phones: a block becomes a swipe row only when its cards come out even and
 * short (tallest under ~450px, less than 150px between tallest and shortest).
 * Otherwise the cards stack and start closed, each one its heading; tap to
 * read it. The block's call is made at build time from the text lengths, so
 * the page arrives in its final phone layout (a script measuring it could run
 * after a paint on a slow connection and move the page). The inline list keeps
 * its first section open and folds the rest. On tablet and desktop every
 * section is open and the headings are plain.
 */
import DepthText from './DepthText.astro';
import type { DepthSection } from '@/data/depth';
export interface Props { sections: DepthSection[]; variant?: 'block' | 'inline'; eyebrow?: string; heading?: string; intro?: string; tone?: 'mist' | 'plain'; /** Phones: the whole section folds to its heading (Base.astro, data-mfold). */ mfold?: boolean }
const { sections, variant = 'block', eyebrow, heading, intro, tone = 'plain', mfold = false } = Astro.props;
const inline = variant === 'inline';
/* Estimated phone height of a swipe card (305px wide), fitted against measured cards:
   heading at ~24 characters a line, body ~33, quote ~26. */
const plain = (t: string) => t.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
const cardH = (s: DepthSection) => 41 + Math.ceil(s.h.length / 24) * 25 + Math.ceil(plain(s.p).length / 33) * 28.2
  + (s.q ? Math.ceil((s.q.text.length + 2) / 26) * 28.2 + Math.ceil(s.q.by.length / 34) * 25 + 40 : 0);
const hs = sections.map(cardH);
const tall = Math.max(...hs) > 450 || Math.max(...hs) - Math.min(...hs) >= 150;
const swipe = sections.length > 1 && !tall;
const blockFold = sections.length > 1 && tall;
---
{inline ? (
  <>
    <div class:list={['dsec-list inline', sections.length > 1 && 'is-fold']} data-dsec="inline">
      {sections.map((s, i) => (
        <details class:list={['dsec', sections.length > 5 && i >= 4 && 'dsx']} open>
          <summary><h3 class="dsec-h">{s.h}</h3><span class="dsec-plus" aria-hidden="true"></span></summary>
          <div class="dsec-b">
            <p><DepthText text={s.p} /></p>
            {s.q && <blockquote class="dsec-q"><p>“{s.q.text}”</p><footer>{s.q.by}</footer></blockquote>}
          </div>
        </details>
      ))}
    </div>
    {sections.length > 5 && <button type="button" class="dsec-more pf-more" aria-expanded="false">Show {sections.length - 4} more topics</button>}
  </>
) : (
  <section class:list={['section-tight', tone === 'mist' && 'bg-mist']} data-mfold={mfold ? '' : undefined}>
    <div class="wrap">
      {(eyebrow || heading) && (
        <div class="section-head">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {heading && <h2 class="h2 sweep">{heading}</h2>}
        </div>
      )}
      {intro && <p class="dsec-intro">{intro}</p>}
      <div class:list={['dsec-list', swipe && 'm-swipe', blockFold && 'is-fold']} data-dsec="block">
        {sections.map((s) => (
          <details class:list={['dsec', s.q && 'has-q']} open>
            <summary><h3 class="dsec-h">{s.h}</h3><span class="dsec-plus" aria-hidden="true"></span></summary>
            <div class="dsec-b">
              <p><DepthText text={s.p} /></p>
              {s.q && <blockquote class="dsec-q"><p>“{s.q.text}”</p><footer>{s.q.by}</footer></blockquote>}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
{(
  <script is:inline>
    (function () {
      /* The fold is in the HTML and CSS (phones, .js): folded sections arrive looking closed.
         This makes it real (closed details), wires "Show more", and turns sections that
         stay open into plain blocks so screen readers don't announce them as toggles. */
      var s = document.currentScript, l = s && s.previousElementSibling, more = null;
      if (l && l.classList.contains('dsec-more')) { more = l; l = l.previousElementSibling; }
      if (l && !l.hasAttribute('data-dsec')) l = l.querySelector('[data-dsec]');
      if (!l) return;
      var ds = [].slice.call(l.querySelectorAll('details')), fold = [];
      var phone = matchMedia('(max-width: 759px)').matches;
      if (phone && l.classList.contains('is-fold')) fold = l.getAttribute('data-dsec') === 'inline' ? ds.slice(1) : ds;
      if (!fold.length) l.classList.remove('is-fold');
      if (more) {
        var extra = ds.slice(4);
        if (!phone) more.remove();
        else {
          extra.forEach(function (d, i) { d.hidden = true; d.id = d.id || 'dsx' + i; });
          more.setAttribute('aria-controls', extra.map(function (d) { return d.id; }).join(' '));
          more.addEventListener('click', function () { extra.forEach(function (d) { d.hidden = false; d.classList.remove('dsx'); }); more.remove(); extra[0].querySelector('summary').focus(); });
        }
      }
      ds.forEach(function (d) {
        if (fold.indexOf(d) > -1) { d.open = false; return; }
        var n = document.createElement('div'), sm = d.querySelector('summary');
        /* Copy every attribute (the class and Astro's scoping attribute), so the block keeps its styles. */
        [].forEach.call(d.attributes, function (a) { if (a.name !== 'open') n.setAttribute(a.name, a.value); });
        n.appendChild(sm.firstElementChild); sm.remove();
        while (d.firstChild) n.appendChild(d.firstChild);
        d.replaceWith(n);
      });
      l.classList.add('is-ready');
    })();
  </script>
)}
<style>
  .dsec-intro { font-size: 1.15rem; line-height: 1.6; color: var(--ink-2); max-width: 66ch; margin-bottom: 1.4rem; }
  .dsec-list { display: grid; gap: 1rem; }
  @media (min-width: 760px) { .dsec-list:not(.inline) { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; } .dsec.has-q { grid-column: 1 / -1; } }
  .dsec { display: block; min-width: 0; }
  .dsec summary { display: block; list-style: none; }
  .dsec summary::-webkit-details-marker { display: none; }
  .dsec summary:hover { color: inherit; }
  .dsec-b { display: grid; gap: .45rem; margin-top: .45rem; }
  .dsec-plus { display: none; }
  .dsec-list:not(.inline) .dsec { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem 1.2rem; }
  .dsec-h { font-family: var(--font-display); font-weight: 800; font-size: 1.2rem; line-height: 1.25; color: var(--navy); }
  .dsec p { font-size: 1.1rem; line-height: 1.6; color: var(--ink-2); overflow-wrap: break-word; }
  .dsec a { font-weight: 700; }
  .dsec-q { margin: .4rem 0 0; padding: .9rem 1rem; border-left: 4px solid var(--blue); background: var(--blue-50); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
  .dsec-q p { color: var(--navy); font-style: italic; }
  .dsec-q footer { margin-top: .4rem; font-size: 1rem; font-weight: 700; color: var(--ink-3); }
  .inline .dsec + .dsec { padding-top: .9rem; border-top: 1px solid var(--line); }
  /* Headings only open and close where the pre-paint script folded the list (phones). */
  .dsec-list:not(.is-fold) summary { pointer-events: none; }
  /* Phones: before the script runs, folded sections look closed (their details are open in the
     HTML so desktop and no-JS readers get everything), and topics past the fourth wait. */
  @media (max-width: 759px) {
    :global(.js) .is-fold:not(.is-ready) .dsec:not(:first-child) > .dsec-b,
    :global(.js) .is-fold:not(.is-ready):not(.inline) .dsec:first-child > .dsec-b { display: none; }
    :global(.js) .inline.is-fold:not(.is-ready) .dsx { display: none; }
  }
  /* The inline list's first topic stays open as a plain block; look like one from the start. */
  .inline.is-fold .dsec:first-child summary { display: block !important; min-height: 0 !important; }
  .inline.is-fold .dsec:first-child .dsec-plus { display: none !important; }
  @media (max-width: 759px) {
    .is-fold .dsec summary { display: flex; align-items: center; justify-content: space-between; gap: .8rem; min-height: 48px; cursor: pointer; }
    .is-fold .dsec-plus { display: block; position: relative; flex: none; width: 36px; height: 36px; border-radius: 50%; background: var(--blue-50); }
    .is-fold .dsec-plus::before, .is-fold .dsec-plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 14px; height: 2.5px; border-radius: 2px; background: var(--navy); translate: -50% -50%; transition: rotate .25s var(--ease); }
    .is-fold .dsec-plus::after { rotate: 90deg; }
    .is-fold.is-ready details[open] .dsec-plus { background: var(--blue); }
    .is-fold.is-ready details[open] .dsec-plus::after { rotate: 0deg; }
    .dsec-list.is-fold:not(.inline) { gap: .6rem; }
    .dsec-list.is-fold:not(.inline) .dsec { padding: .55rem 1rem .55rem 1.1rem; }
    .dsec-list.is-fold.is-ready:not(.inline) .dsec[open] { padding-bottom: 1rem; }
    .is-fold .dsec-b { margin-top: .2rem; }
    .inline.is-fold .dsec + .dsec { padding-top: .5rem; }
    .inline.is-fold.is-ready .dsec[open] + .dsec { padding-top: .9rem; }
    .inline.is-fold.is-ready .dsec:not(:first-child)[open] { padding-bottom: .4rem; }
  }
  @media (prefers-reduced-motion: reduce) { .dsec-plus::before, .dsec-plus::after { transition: none; } }
</style>
