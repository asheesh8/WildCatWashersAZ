---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { cta } from '@/data/business';
---
<Base title="Page not found | Wildcat Washers" description="That page moved or never existed." noindex>
  <PageHero eyebrow="404" title="That page isn’t here" lede="It may have moved when we rebuilt the site. Try one of these, or give us a call." rating={false} ctaLabel="Go to the homepage" ctaHref="/" />
  <section class="section-tight">
    <div class="wrap">
      <ul class="chips" role="list">
        <li><a href="/services/"><Icon name="arrow" size={18} />Services</a></li>
        <li><a href="/areas/"><Icon name="pin" size={18} />Areas we serve</a></li>
        <li><a href="/guides/"><Icon name="arrow" size={18} />Answers</a></li>
        <li><a href={cta.quoteHref}><Icon name="arrow" size={18} />Free quote</a></li>
      </ul>
    </div>
  </section>
</Base>
