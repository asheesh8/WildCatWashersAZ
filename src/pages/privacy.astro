---
import Base from '@/layouts/Base.astro';
import { company } from '@/data/business';
const crumbs = [{ name: 'Privacy', href: '/privacy/' }];
---
<Base title="Privacy Policy | Wildcat Washers" description="How Wildcat Washers handles the information you send us through our quote form, phone calls and email, and who to contact with questions." breadcrumbs={crumbs}>
  <section class="section-tight"><div class="wrap-narrow prose">
    <h1 class="h2">Privacy policy</h1>
    <p>When you call us or send the quote form, we use your name, phone number, email and the details you give us only to quote, schedule and complete your service and to send your appointment reminders.</p>
    <p>We don’t sell or rent your information. We share it only with the service providers that help us run scheduling, messaging and payments, and only for those purposes.</p>
    <p>Questions or requests about your information: email <a href={`mailto:${company.email}`}>{company.email}</a> or call {company.phone}.</p>
  </div></section>
</Base>
