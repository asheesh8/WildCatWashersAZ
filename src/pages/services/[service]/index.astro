---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import TrustRow from '@/components/TrustRow.astro';
import FiveInOne from '@/components/FiveInOne.astro';
import LoopVideo from '@/components/LoopVideo.astro';
import { seeItDone, seeItDoneLede } from '@/data/videos';
import WhyGrid from '@/components/WhyGrid.astro';
import FactsTrio from '@/components/FactsTrio.astro';
import Gallery from '@/components/Gallery.astro';
import { sceneOf } from '@/data/media';
import ReviewGrid from '@/components/ReviewGrid.astro';
import FaqList from '@/components/FaqList.astro';
import ServiceGrid from '@/components/ServiceGrid.astro';
import ClubBlock from '@/components/ClubBlock.astro';
import Icon from '@/components/Icon.astro';
import { services, serviceHref, type Service } from '@/data/business';
import { towns, townHref } from '@/data/areas';
import { localServices } from '@/data/localServices';
import { fitTitle } from '@/lib/seo';
import { reviewsForService, pick } from '@/data/reviews';
import { faqList } from '@/data/faq';
import { h1For, planFor } from '@/data/plan';
import { landings } from '@/data/landing';
import { faqSchema, serviceSchema } from '@/lib/schema';
import { guidePages } from '@/data/guides';

export function getStaticPaths() {
  return services.map((s) => ({ params: { service: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Service };
const url = serviceHref(s.slug);
const title = h1For(url, s.h1);
const faqs = faqList(s.faq);
const matched = reviewsForService(s.reviewTags);
const reviews = pick(matched, 6, { seed: s.slug.length * 7 });
const isWindow = s.slug === 'window-cleaning';
const crumbs = [{ name: 'Services', href: '/services/' }, { name: s.name, href: url }];
/* Service × town pages where they exist; otherwise the town hub. */
const localTowns = new Set(localServices.filter((x) => x.service === s.slug).map((x) => x.town));
/* Sub-service pages under this hub; screen repair also points to solar screen rescreening. */
const subPages = landings
  .filter((l) => l.url.startsWith(`/services/${s.slug}/`) || (s.slug === 'screen-repair' && l.url === '/services/solar-screens/repair-rescreening/')
    /* Solar hubs also point to commercial arrays. */
    || (['solar-panel-cleaning', 'solar-panel-pigeon-proofing'].includes(s.slug) && l.url === '/commercial/commercial-solar/'))
  .filter((l) => planFor(l.url))
  .map((l) => ({ href: l.url, label: planFor(l.url)!.h1 }));
/* Other names people search for sit in one plain sentence, not a keyword-list eyebrow. */
const aka = s.aka.filter((a) => !/ers$/.test(a)); // "window cleaners" names people, not the service
const akaText = aka.length > 1 ? `${aka.slice(0, -1).join(', ')} or ${aka.at(-1)}` : aka[0];
const heroLede = akaText ? `${s.lede} Some people know it as ${akaText}.` : s.lede;
/* The photo in the "what's included" block; the gallery skips it and every other photo already on the page. */
/* The included photo never shows the hero's scene again (same house from another angle). */
const fiveImage = isWindow ? 'tech-kneeling-window-detail' : s.gallery.find((k) => sceneOf(k) !== sceneOf(s.image)) ?? s.image;
const relatedImages = services.filter((x) => s.related.includes(x.slug)).map((x) => x.image);
const onPage = [s.image, fiveImage, ...relatedImages];
/* Answer guides that lead to this service: the hub links every one (phones show six, then "Show more"). */
const answers = guidePages.filter((p) => p.g.service === s.slug || (s.slug === 'solar-panel-pigeon-proofing' && p.url === '/guides/bird-droppings-on-solar-panels/')).sort((a, b) => a.row.id - b.row.id);
const areaLinks = towns.map((t) => (localTowns.has(t.slug) ? { href: `/services/${s.slug}/${t.slug}/`, name: t.name } : { href: townHref(t.slug), name: t.name }));
---
<Base
  title={fitTitle([`${s.name} Tucson`, `${s.name} in Tucson`])}
  description={`${s.lede.split('. ')[0]}. ${matched.length ? `${matched.length}+ five-star reviews. ` : ''}Free quote: (520) 525-0084.`}
  breadcrumbs={crumbs}
  schema={[serviceSchema(s), faqSchema(faqs)]}
  ctaService={s.slug}
>
  <PageHero trust eyebrow={`${s.name} · Tucson metro`} title={title} lede={heroLede} crumbs={crumbs} image={s.image} ctaLabel={s.cta} ctaHref={`/quote/?service=${s.slug}`} />
  <TrustRow />

  {isWindow ? (
    <FiveInOne image={fiveImage} />
  ) : (
    <FiveInOne eyebrow="What’s included" title={`What your ${s.short.toLowerCase()} service includes`} lede={s.cardLine} items={s.included} image={fiveImage} />
  )}

  {seeItDone[s.slug] && (
    <section class="section-tight see">
      <div class:list={['wrap', seeItDone[s.slug].length === 1 && 'see-one']}>
        <div class="section-head"><p class="eyebrow">Real jobs, no stock footage</p><h2 class="h2 sweep">See it done</h2>{seeItDoneLede[s.slug] && <p class="lede">{seeItDoneLede[s.slug]}</p>}</div>
        <div class:list={['see-row', seeItDone[s.slug].length > 1 ? 'm-swipe' : 'is-single']}>{seeItDone[s.slug].map((k) => <LoopVideo name={k} caption />)}</div>
      </div>
    </section>
  )}

  <WhyGrid eyebrow="Why it matters in Tucson" title={isWindow ? 'Why the whole window matters' : `Why ${s.name.toLowerCase()} matters here`} items={s.why} tone="mist" />

  <Gallery keys={s.gallery} title="From recent jobs" avoid={onPage} swipe />

  <FactsTrio pricing={s.pricing} frequency={s.frequency} duration={s.duration} limits={s.limits} />

  {reviews.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">{matched.length} reviews mention {s.short.toLowerCase()}</p>
          <h2 class="h2 sweep">What customers say about our {s.short.toLowerCase()} work</h2>
        </div>
        <ReviewGrid reviews={reviews} />
        <p style="margin-top:1.6rem"><a class="text-link" href="/reviews/">Read all our reviews <Icon name="arrow" size={20} /></a></p>
      </div>
    </section>
  )}

  {isWindow && <ClubBlock collapse />}

  {subPages.length > 0 && (
    <section class="section-tight">
      <div class="wrap">
        <h2 class="h3" style="margin-bottom:1rem">{s.slug === 'screen-repair' ? 'Solar screens too' : `Specific ${s.name.toLowerCase()} jobs`}</h2>
        <ul class="chips" role="list">{subPages.map((p) => <li><a href={p.href}><Icon name="arrow" size={18} />{p.label}</a></li>)}</ul>
      </div>
    </section>
  )}

  <section class="section-tight bg-mist">
    <div class="wrap">
      <h2 class="h3" style="margin-bottom:1rem">{isWindow ? 'Window cleaning near you' : `${s.name} across Southern Arizona`}</h2>
      <ul class="chips town-chips" role="list">
        {areaLinks.slice(0, 6).map((a) => <li><a href={a.href}><Icon name="pin" size={18} />{a.name}</a></li>)}
      </ul>
      {/* Phones: six towns show and the rest open with one tap. Desktop shows every town. */}
      <details class="town-more" open>
        <summary><span class="tm-open">Show all {areaLinks.length} towns</span><span class="tm-close">Show fewer towns</span><Icon name="plus" size={20} /></summary>
        <ul class="chips town-chips" role="list">
          {areaLinks.slice(6).map((a) => <li><a href={a.href}><Icon name="pin" size={18} />{a.name}</a></li>)}
          <li><a href="/areas/"><Icon name="plus" size={18} />All areas</a></li>
        </ul>
      </details>
      <script is:inline>
        (function () {
          var d = document.currentScript && document.currentScript.previousElementSibling;
          if (d && matchMedia('(max-width: 759px)').matches) d.open = false;
        })();
      </script>
    </div>
  </section>

  {answers.length > 0 && (
    <section class="section-tight">
      <div class="wrap">
        <h2 class="h3" style="margin-bottom:1rem">Answers about {s.name.toLowerCase()}</h2>
        <ul class="ans-links" role="list" id="svc-answers" data-pfold="6">
          {answers.map((a) => <li><a href={a.url}><Icon name="arrow" size={18} />{a.row.h1}</a></li>)}
        </ul>
        {answers.length > 7 && <button type="button" class="pf-more" aria-controls="svc-answers" aria-expanded="false">Show {answers.length - 6} more answers</button>}
        <p style="margin-top:1rem"><a class="text-link" href="/guides/">All answers and guides <Icon name="arrow" size={20} /></a></p>
      </div>
    </section>
  )}

  <FaqList items={faqs} title={`${s.name} questions`} openFirst={false} />

  <section class="section-tight">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Pairs well with</p><h2 class="h2">Add it to the same visit</h2></div>
      <ServiceGrid only={s.related} />
    </div>
  </section>
</Base>

<style>
  .ans-links { list-style: none; padding: 0; display: grid; gap: .1rem 1.6rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .ans-links a { display: flex; gap: .5rem; align-items: flex-start; min-height: 44px; padding: .55rem 0; font-weight: 700; color: var(--navy); text-decoration: none; border-bottom: 1px solid var(--line); }
  .ans-links a :global(svg) { flex: none; margin-top: .2rem; color: var(--blue-700); }
  .ans-links a:hover { color: var(--blue-700); }
  .see-row { display: grid; gap: 1rem; grid-template-columns: repeat(3, 1fr); }
  .see-row :global(.loop) { align-self: start; }
  .see-row.is-single { grid-template-columns: minmax(0, 380px); }
  @media (min-width: 900px) { .see-one { display: grid; grid-template-columns: 1fr 380px; gap: 3rem; align-items: center; } .see-one .section-head { margin: 0; } }
  .see-row :global(video) { aspect-ratio: 4 / 5; }
  @media (max-width: 759px) { .see-row { display: flex; } .see-row :global(.loop) { flex: 0 0 72%; } }
  .town-more summary { display: none; }
  .town-more > .town-chips { margin-top: .6rem; }
  @media (max-width: 759px) {
    /* Phones: towns in a tidy two-column grid instead of ragged rows of pills. */
    .town-chips { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
    .town-chips a { width: 100%; height: 100%; padding: .55rem .8rem; line-height: 1.25; }
    .town-more > .town-chips { margin-top: .5rem; }
    .town-more summary {
      display: flex; align-items: center; justify-content: space-between; gap: .6rem; list-style: none; cursor: pointer;
      min-height: 48px; margin-top: .5rem; padding: .5rem 1rem; border-radius: 999px; background: #fff; border: 1px solid var(--line);
      font-weight: 800; color: var(--navy);
    }
    .town-more summary::-webkit-details-marker { display: none; }
    .town-more .tm-close, .town-more[open] .tm-open { display: none; }
    .town-more[open] .tm-close { display: inline; }
    .town-more summary :global(svg) { color: var(--blue-700); transition: rotate .25s var(--ease); }
    .town-more[open] summary :global(svg) { rotate: 45deg; }
    /* Five lines of each review before "Read the whole review". */
    :global(.js .rgrid blockquote p:not(.open)) { -webkit-line-clamp: 5; line-clamp: 5; }
  }
  @media (prefers-reduced-motion: reduce) { .town-more summary :global(svg) { transition: none; } }
</style>