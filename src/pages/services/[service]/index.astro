---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import TrustRow from '@/components/TrustRow.astro';
import FiveInOne from '@/components/FiveInOne.astro';
import WhyGrid from '@/components/WhyGrid.astro';
import FactsTrio from '@/components/FactsTrio.astro';
import Gallery from '@/components/Gallery.astro';
import ReviewGrid from '@/components/ReviewGrid.astro';
import FaqList from '@/components/FaqList.astro';
import ServiceGrid from '@/components/ServiceGrid.astro';
import ClubBlock from '@/components/ClubBlock.astro';
import Icon from '@/components/Icon.astro';
import { services, serviceHref, type Service } from '@/data/business';
import { towns, townHref } from '@/data/areas';
import { localServices } from '@/data/localServices';
import { fitTitle } from '@/lib/seo';
import { reviewsForService, pick } from '@/data/reviews';
import { faqList } from '@/data/faq';
import { h1For } from '@/data/plan';
import { faqSchema, serviceSchema } from '@/lib/schema';

export function getStaticPaths() {
  return services.map((s) => ({ params: { service: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Service };
const url = serviceHref(s.slug);
const title = h1For(url, s.h1);
const faqs = faqList(s.faq);
const matched = reviewsForService(s.reviewTags);
const reviews = pick(matched, 6, { seed: s.slug.length * 7 });
const isWindow = s.slug === 'window-cleaning';
const crumbs = [{ name: 'Services', href: '/services/' }, { name: s.name, href: url }];
/* Service × town pages where they exist; otherwise the town hub. */
const localTowns = new Set(localServices.filter((x) => x.service === s.slug).map((x) => x.town));
const areaLinks = towns.map((t) => (localTowns.has(t.slug) ? { href: `/services/${s.slug}/${t.slug}/`, name: t.name } : { href: townHref(t.slug), name: t.name }));
---
<Base
  title={fitTitle([`${s.name} Tucson`, `${s.name} in Tucson`])}
  description={`${s.lede.split('. ')[0]}. ${matched.length ? `${matched.length}+ five-star reviews. ` : ''}Free quote: (520) 525-0084.`}
  breadcrumbs={crumbs}
  schema={[serviceSchema(s), faqSchema(faqs)]}
  ctaService={s.slug}
>
  <PageHero eyebrow={s.aka.length ? `Also called ${s.aka.join(', ')}` : s.name} title={title} lede={s.lede} crumbs={crumbs} image={s.image} ctaLabel={s.cta} ctaHref={`/quote/?service=${s.slug}`} />
  <TrustRow />

  {isWindow ? (
    <FiveInOne />
  ) : (
    <FiveInOne eyebrow="What’s included" title={`What your ${s.short.toLowerCase()} service includes`} lede={s.cardLine} items={s.included} image={s.gallery[0] ?? s.image} />
  )}

  <WhyGrid eyebrow="Why it matters in Tucson" title={isWindow ? 'Why the whole window matters' : `Why ${s.name.toLowerCase()} matters here`} items={s.why} tone="mist" />

  <Gallery keys={s.gallery} title="From recent jobs" />

  <FactsTrio pricing={s.pricing} frequency={s.frequency} duration={s.duration} limits={s.limits} />

  {reviews.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">{matched.length} reviews mention {s.short.toLowerCase()}</p>
          <h2 class="h2 sweep">What customers say about our {s.short.toLowerCase()} work</h2>
        </div>
        <ReviewGrid reviews={reviews} />
        <p style="margin-top:1.6rem"><a class="text-link" href="/reviews/">Read all our reviews <Icon name="arrow" size={20} /></a></p>
      </div>
    </section>
  )}

  {isWindow && <ClubBlock />}

  <section class="section-tight bg-mist">
    <div class="wrap">
      <h2 class="h3" style="margin-bottom:1rem">{isWindow ? 'Window cleaning near you' : `${s.name} across Southern Arizona`}</h2>
      <ul class="chips" role="list">
        {areaLinks.map((a) => <li><a href={a.href}><Icon name="pin" size={18} />{a.name}</a></li>)}
        <li><a href="/areas/"><Icon name="plus" size={18} />All areas</a></li>
      </ul>
    </div>
  </section>

  <FaqList items={faqs} title={`${s.name} questions`} />

  <section class="section-tight">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Pairs well with</p><h2 class="h2">Add it to the same visit</h2></div>
      <ServiceGrid only={s.related} />
    </div>
  </section>
</Base>

