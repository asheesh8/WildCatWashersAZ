---
/** /services/<service>/<town>/ (service × location) and /services/<service>/<sub-service>/. */
import ServiceTownPage from '@/components/ServiceTownPage.astro';
import LandingPage from '@/components/LandingPage.astro';
import { localServices, type LocalService } from '@/data/localServices';
import { townBySlug, type Town } from '@/data/areas';
import { landingsUnder } from '@/data/landing';
import type { Landing } from '@/data/landing/types';
import { serviceBySlug, serviceHref } from '@/data/business';
import { planFor } from '@/data/plan';

export function getStaticPaths() {
  return [
    ...localServices.map((ls) => ({ params: { service: ls.service, location: ls.town }, props: { ls, t: townBySlug[ls.town] } })),
    ...landingsUnder('/services/').map((l) => ({ params: { service: l.url.split('/')[2], location: l.url.split('/')[3] }, props: { l } })),
  ];
}
const { ls, t, l } = Astro.props as { ls?: LocalService; t?: Town; l?: Landing };
const svc = serviceBySlug[l ? l.url.split('/')[2] : ls!.service];
const crumbs = l ? [{ name: 'Services', href: '/services/' }, { name: svc.name, href: serviceHref(svc.slug) }, { name: planFor(l.url)!.h1, href: l.url }] : [];
---
{l ? <LandingPage l={l} crumbs={crumbs} eyebrow={svc.name} /> : <ServiceTownPage ls={ls!} t={t!} />}
