---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import TrustRow from '@/components/TrustRow.astro';
import ServiceGrid from '@/components/ServiceGrid.astro';
import FiveInOne from '@/components/FiveInOne.astro';
import ClubBlock from '@/components/ClubBlock.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import { h1For } from '@/data/plan';
const crumbs = [{ name: 'Services', href: '/services/' }];
---
<Base title="Window, Solar & Exterior Cleaning Services | Wildcat Washers" description="Window cleaning, solar panel cleaning, pigeon proofing, solar screens, screen repair and pressure washing across Greater Tucson. Call (520) 525-0084." breadcrumbs={crumbs}>
  <PageHero trust eyebrow="What we clean" title={h1For('/services/', 'Window, Solar and Exterior Cleaning Services')} lede="Six services, one uniformed crew, and the same standard on every job. Book one, or bundle a few into a single visit." crumbs={crumbs} image="two-techs-tall-glass" />
  <TrustRow />
  <section class="section"><div class="wrap"><ServiceGrid /></div></section>
  <FiveInOne />
  <ClubBlock />
  <ProcessSteps />
</Base>
