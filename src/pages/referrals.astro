---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { offers } from '@/data/business';
import { h1For } from '@/data/plan';
const crumbs = [{ name: 'Refer a neighbor', href: '/referrals/' }];
---
<Base title="Refer a Neighbor: You Get $50, They Get $25 | Wildcat Washers" description={offers.referral.body} breadcrumbs={crumbs}>
  <PageHero eyebrow="Referral program" title={h1For('/referrals/', 'Refer a Neighbor')} lede={`${offers.referral.headline}. ${offers.referral.body}`} crumbs={crumbs} image="clean-patio-sliders" />
</Base>
