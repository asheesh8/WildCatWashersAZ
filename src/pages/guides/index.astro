---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { faqCategories, faqs } from '@/data/faq';
import { h1For } from '@/data/plan';
import { guidePages } from '@/data/guides';
const crumbs = [{ name: 'Guides and answers', href: '/guides/' }];
const slug = (c: string) => c.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const pillars = guidePages.filter((p) => p.row.family === 'guide');
const answers = guidePages.filter((p) => p.row.family === 'answer');
const groups: { name: string; test: (s?: string) => boolean }[] = [
  { name: 'Windows and hard water', test: (s) => s === 'window-cleaning' },
  { name: 'Solar panels', test: (s) => s === 'solar-panel-cleaning' },
  { name: 'Pigeons under solar panels', test: (s) => s === 'solar-panel-pigeon-proofing' },
  { name: 'Solar screens and window screens', test: (s) => s === 'solar-screens' || s === 'screen-repair' },
  { name: 'Pressure washing', test: (s) => s === 'pressure-washing' },
  { name: 'Hiring, cost and scheduling', test: (s) => !s },
];
const grouped = groups.map((gr) => ({ name: gr.name, items: answers.filter((p) => gr.test(p.g.service)) })).filter((gr) => gr.items.length);
---
<Base title="Guides & Answers for Tucson Homes | Wildcat Washers" description="Straight answers about keeping Tucson windows, solar panels, screens and patios clean, from the crew that does it every day." breadcrumbs={crumbs}>
  <PageHero eyebrow="Learn before you book" title={h1For('/guides/', 'Guides and Answers')} lede="Desert dust, hard water, monsoon season, pigeons and sun. Here’s what we’ve learned cleaning Tucson homes every day, answered plainly." crumbs={crumbs} rating={false} />
  <section class="section-tight">
    <div class="wrap">
      <h2 class="h3" style="margin-bottom:1rem">Start with a guide</h2>
      <ul class="topics" role="list">
        {pillars.map((p) => <li><a href={p.url}><strong>{p.row.h1}</strong><span>Guide</span><Icon name="arrow" size={20} /></a></li>)}
      </ul>
      {grouped.map((gr) => (
        <details class="grp">
          <summary><span>{gr.name}</span><span class="n">{gr.items.length} answers</span></summary>
          <ul class="qs" role="list">{gr.items.map((p) => <li><a href={p.url}>{p.row.h1}</a></li>)}</ul>
        </details>
      ))}
      <h2 class="h3" style="margin:2.4rem 0 1rem">Every question, by topic</h2>
      <ul class="topics" role="list">
        {faqCategories.map((c) => (
          <li><a href={`/faq/#${slug(c)}`}><strong>{c}</strong><span>{faqs.filter((f) => f.category === c).length} answers</span><Icon name="arrow" size={20} /></a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
<style>
  .topics { list-style: none; padding: 0; display: grid; gap: .8rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); margin-bottom: 2rem; }
  .topics a { display: grid; grid-template-columns: 1fr auto; padding: 1.3rem 1.4rem; border: 2px solid var(--line); border-radius: var(--radius); text-decoration: none; background: #fff; }
  .topics a:hover { border-color: var(--blue); }
  .topics strong { font-family: var(--font-display); font-weight: 800; font-size: 1.2rem; }
  .topics span { color: var(--ink-3); grid-row: 2; }
  .topics :global(svg) { grid-row: 1 / 3; grid-column: 2; align-self: center; color: var(--blue-700); }
  .grp { border: 2px solid var(--line); border-radius: var(--radius); background: #fff; margin-bottom: .7rem; }
  .grp[open] { border-color: var(--blue); }
  .grp summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.3rem; font-family: var(--font-display); font-weight: 800; font-size: 1.2rem; color: var(--navy); }
  .grp summary::-webkit-details-marker { display: none; }
  .grp .n { color: var(--ink-3); font-weight: 600; font-family: var(--font-body, inherit); font-size: 1rem; }
  .qs { list-style: none; padding: 0 1.3rem 1.2rem; display: grid; gap: .5rem; }
  .qs a { font-size: 1.1rem; font-weight: 600; }
</style>
