---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import ServiceCards from '@/components/ServiceCards.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import Reviews from '@/components/Reviews.astro';
import CtaBand from '@/components/CtaBand.astro';
import QuoteForm from '@/components/QuoteForm.astro';
import AskWildcat from '@/components/AskWildcat.astro';
import { services, locations, faqById, company, proof, guarantees, awards } from '@/data/business';
import { reviewsFor } from '@/data/reviews';
import { img, altFor, pools, pickFrom } from '@/data/media';

export function getStaticPaths() {
  return locations.map((location) => ({ params: { location: location.slug }, props: { location } }));
}

const { location: l } = Astro.props;
const nearby = locations.filter((x) => x.slug !== l.slug);
const localReviews = reviewsFor(undefined, l.name);
const teamKey = pickFrom(pools.team, l.slug);

const localFaqs = [
  {
    id: `serve-${l.slug}`,
    q: `Do you serve ${l.name}?`,
    a: `Yes — ${l.name} is one of our eight core service areas and we are there most weeks, including ${l.communities.join(', ')}. Because we run a route rather than one-off trips, a ${l.name} address can usually be fitted in within the same week.`,
    topics: ['areas'],
  },
  {
    id: `lead-${l.slug}`,
    q: `How quickly can you get to a ${l.name} home?`,
    a: `Most ${l.name} quotes go out the same day, and most jobs are scheduled inside a week. The retirement communities get busy in autumn and spring, so booking a week or two ahead is sensible around then.`,
    topics: ['process'],
  },
  {
    id: `neighbours-${l.slug}`,
    q: `Can you do my neighbour's house on the same day?`,
    a: `Please do — it is genuinely cheaper for everyone. Same-street, same-day jobs cut our drive time and we pass that back in the pricing. A lot of our ${l.name} work starts as one house and becomes four.`,
    topics: ['pricing'],
  },
  faqById['how-often-windows'],
  faqById['guarantee'],
  faqById['trust-in-home'],
].filter(Boolean);

const title = `Window, Solar & Pressure Washing in ${l.name}, AZ | Wildcat Washers`;
const description = `Every Wildcat Washers service in ${l.name}, AZ — window cleaning, solar panel cleaning and pressure washing across ${l.communities.slice(0, 3).join(', ')} and nearby. ${proof.customersServedLabel} customers, never a review below 5 stars. Free same-day quotes.`;

const schema = [
  {
    '@type': 'Service',
    name: `Window cleaning and exterior cleaning in ${l.name}, AZ`,
    description,
    provider: { '@id': `${company.url}/#business` },
    areaServed: {
      '@type': 'City',
      name: l.fullName,
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Arizona' },
    },
  },
  {
    '@type': 'FAQPage',
    mainEntity: localFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title={title}
  description={description}
  canonical={`/areas/${l.slug}/`}
  schema={schema}
  breadcrumbs={[{ name: 'Service Areas', href: '/areas/' }, { name: l.name, href: `/areas/${l.slug}/` }]}
>
  <!-- ---------------------------------------------------------------- hero -->
  <section class="ahero">
    <div class="ahero-bg">
      <Image src={img(l.heroImage)} alt={altFor(l.heroImage)} widths={[720, 1200, 1800]} sizes="100vw" loading="eager" fetchpriority="high" quality={70} class="cover" />
      <div class="ahero-scrim"></div>
    </div>
    <div class="wrap ahero-in">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>
        <a href="/areas/">Service Areas</a> <span aria-hidden="true">/</span>
        <span aria-current="page">{l.name}</span>
      </nav>
      <h1>Everything we clean in <span class="swipe">{l.name}</span>, AZ</h1>
      <p class="ahero-blurb">{l.blurb}</p>
      <div class="ahero-cta">
        <a class="btn btn-lg" href={`/quote/?area=${l.slug}`}>Get your free quote</a>
        <a class="btn btn-lg btn-outline-light" href={`tel:${company.phoneRaw}`}>Call {company.phone}</a>
      </div>
      <div class="ahero-ask"><AskWildcat variant="hero" placeholder={`Ask anything about our ${l.name} service…`} /></div>
    </div>
  </section>

  <!-- ---------------------------------------------------------- local bar -->
  <section class="lbar">
    <div class="wrap lbar-in">
      <div><dt>Communities served</dt><dd>{l.communities.length}+ in {l.name}</dd></div>
      <div><dt>ZIP codes</dt><dd>{l.zips.join(', ')}</dd></div>
      <div><dt>Quote turnaround</dt><dd>Usually same day</dd></div>
      <div><dt>Typical lead time</dt><dd>Within the week</dd></div>
    </div>
  </section>

  <!-- ------------------------------------------------------------ services -->
  <section class="section">
    <div class="wrap">
      <SectionHead
        eyebrow={`In ${l.name}`}
        title="What we do here."
        lede={`All three services run on the same ${l.name} route, so booking two at once costs less than two separate visits.`}
      />
      <ServiceCards area={l.slug} areaName={l.name} />
    </div>
  </section>

  <!-- --------------------------------------------------------- local notes -->
  <section class="section tone-soft">
    <div class="wrap two">
      <div>
        <SectionHead
          eyebrow="Local conditions"
          title={`What ${l.name} does to glass.`}
          lede={`We have been cleaning in ${l.name} long enough to know what it throws at a house.`}
        />
        <ul class="notes">
          {l.localNotes.map((n, i) => (
            <li><span>{String(i + 1).padStart(2, '0')}</span><p>{n}</p></li>
          ))}
        </ul>
      </div>
      <div class="comm">
        <h3>{l.name} communities we work in</h3>
        <ul class="comm-list">{l.communities.map((c) => <li>{c}</li>)}</ul>
        <p class="comm-note">
          Plus the surrounding {l.name} neighbourhoods. Not listed? It almost certainly still
          falls inside our route — <a href="/contact/">just ask</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ----------------------------------------------------------- the crew -->
  <section class="section">
    <div class="wrap two two-mid">
      <figure class="crew-fig">
        <Image src={img(teamKey)} alt={altFor(teamKey)} widths={[420, 780, 1040]} sizes="(max-width: 900px) 92vw, 46vw" quality={76} class="cover" />
      </figure>
      <div>
        <SectionHead
          eyebrow="Who turns up"
          title={`The same crew, every ${l.name} visit.`}
          lede="A marked truck, a uniformed team and an introduction at the door. You will recognise us the second time."
        />
        <ul class="ticks">
          <li>Licensed and insured, BBB accredited</li>
          <li>Appointment confirmed before we come</li>
          <li>Protection down before anything gets wet</li>
          <li>Walkthrough with you before we ask for payment</li>
        </ul>
        <div class="crew-awards">
          {awards.slice(0, 3).map((a) => (
            <span class="pill pill-cyan">{a.short}{a.year ? ` ${a.year}` : ''}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------ process -->
  <section class="section tone-soft">
    <div class="wrap proc">
      <SectionHead eyebrow="How it works" title={`Booking a ${l.name} clean.`} />
      <div class="proc-inner"><ProcessSteps /></div>
    </div>
  </section>

  {localReviews.length > 0 && (
    <section class="section">
      <div class="wrap">
        <SectionHead eyebrow="Local reviews" title={`From ${l.name} customers.`} />
        <Reviews items={localReviews} limit={3} />
      </div>
    </section>
  )}

  <!-- ---------------------------------------------------------- guarantee -->
  <section class="section tone-navy">
    <div class="wrap">
      <SectionHead
        eyebrow="Risk reversal"
        title="Two guarantees behind every job."
        lede={`Same in ${l.name} as everywhere else we work.`}
      />
      <div class="guars">
        {guarantees.map((g) => (
          <article>
            <h3>{g.name}</h3>
            <p class="g-head">{g.headline}</p>
            <p class="g-body">{g.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ----------------------------------------------------------------- faq -->
  <section class="section">
    <div class="wrap faq-wrap">
      <SectionHead eyebrow="Questions" title={`${l.name} — the common questions.`} />
      <FaqAccordion items={localFaqs} />
    </div>
  </section>

  <!-- ---------------------------------------------------------- nearby -->
  <section class="section tone-soft">
    <div class="wrap">
      <SectionHead eyebrow="Nearby" title="Other towns on our route." />
      <ul class="near">
        {nearby.map((n) => (
          <li><a href={`/areas/${n.slug}/`}>{n.name}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m0 0-5.5-5.5M18 12l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
        ))}
      </ul>
      <div class="near-services">
        <h3>{l.name} service pages</h3>
        <ul>
          {services.map((s) => (
            <li><a href={`/services/${s.slug}/${l.slug}/`}>{s.name} in {l.name}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CtaBand
    area={l.slug}
    title={`Book a ${l.name} clean.`}
    lede={`Tell us your ${l.name} address and roughly what you need. Fixed price, usually the same day — and you don't pay until you're happy.`}
  />

  <section class="section">
    <div class="wrap-narrow">
      <SectionHead align="center" eyebrow="Free quote" title={`${l.name}, AZ`} />
      <QuoteForm area={l.slug} id={`q-${l.slug}`} />
    </div>
  </section>
</Base>

<style>
  .ahero { position: relative; isolation: isolate; padding-block: clamp(2.5rem, 6vw, 4.5rem); color: #fff; overflow: hidden; }
  .ahero-bg { position: absolute; inset: 0; z-index: -1; }
  .ahero-bg :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 48%; }
  .ahero-scrim { position: absolute; inset: 0; background: linear-gradient(100deg, rgba(9,13,30,.95) 0%, rgba(9,13,30,.84) 48%, rgba(9,13,30,.58) 100%); }
  .ahero-in { max-width: 820px; }
  .ahero h1 { font-size: var(--step-4); color: #fff; margin-block: .5rem .7rem; text-transform: none; }
  .ahero h1 .swipe::after { background: var(--cyan); opacity: .95; height: .15em; }
  .ahero-blurb { font-size: var(--step-1); line-height: 1.45; color: #d7deee; max-width: 56ch; margin-bottom: 1.6rem; }
  .ahero-cta { display: flex; flex-wrap: wrap; gap: .7rem; margin-bottom: 1.6rem; }
  @media (max-width: 640px) { .ahero-cta .btn { flex: 1 1 100%; } }
  .ahero-ask { max-width: 680px; }

  .crumbs { font-size: .85rem; color: #9fadcb; display: flex; flex-wrap: wrap; gap: .4rem; }
  .crumbs a { color: #cfd8ec; text-decoration: none; }
  .crumbs a:hover { color: var(--cyan); }
  .crumbs span[aria-current] { color: #fff; font-weight: 600; }

  .lbar { background: var(--navy-700); color: #cbd5ea; }
  .lbar-in { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem 2rem; padding-block: 1.25rem; }
  @media (max-width: 780px) { .lbar-in { grid-template-columns: 1fr 1fr; } }
  .lbar dt { font-size: .76rem; letter-spacing: .1em; text-transform: uppercase; color: #8f9cbe; margin-bottom: .2rem; }
  .lbar dd { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: #fff; }

  .two { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .two-mid { grid-template-columns: .9fr 1.1fr; align-items: center; }
  @media (max-width: 900px) { .two, .two-mid { grid-template-columns: 1fr; } }

  .notes { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  .notes li { display: grid; grid-template-columns: 40px 1fr; gap: 1rem; align-items: start; }
  .notes span { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: var(--navy); color: #fff; font-family: var(--font-display); font-weight: 900; font-size: .85rem; }
  .notes p { color: var(--ink-2); line-height: 1.6; font-size: .99rem; }

  .comm { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(1.4rem, 3vw, 1.9rem); }
  .comm h3 { font-size: 1.12rem; margin-bottom: .9rem; }
  .comm-list { list-style: none; margin: 0 0 1rem; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  .comm-list li { padding: .35rem .8rem; border-radius: 999px; background: var(--cyan-50); border: 1px solid var(--cyan-100); font-size: .88rem; font-weight: 600; color: var(--navy-600); }
  .comm-note { font-size: .93rem; color: var(--ink-3); line-height: 1.55; }

  .crew-fig { margin: 0; }
  .crew-fig :global(img) { width: 100%; border-radius: var(--radius-xl); aspect-ratio: 4/3; object-fit: cover; box-shadow: var(--shadow); }
  .crew-awards { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.4rem; }

  .proc-inner { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: .5rem clamp(1.25rem, 3vw, 2.25rem); }

  .guars { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1rem, 2.5vw, 1.75rem); }
  @media (max-width: 860px) { .guars { grid-template-columns: 1fr; } }
  .guars article { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.12); border-radius: var(--radius-lg); padding: 1.6rem; }
  .guars h3 { font-size: 1.2rem; color: var(--cyan); margin-bottom: .45rem; }
  .g-head { font-family: var(--font-display); font-weight: 700; color: #fff; margin-bottom: .55rem; line-height: 1.3; }
  .g-body { color: #b6c1dc; font-size: .96rem; line-height: 1.6; }

  .faq-wrap { max-width: 900px; }

  .near { list-style: none; margin: 0 0 2.5rem; padding: 0; display: flex; flex-wrap: wrap; gap: .6rem; }
  .near a {
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .7rem 1.1rem; border-radius: 999px;
    background: #fff; border: 1px solid var(--line);
    font-family: var(--font-display); font-weight: 700; color: var(--navy); text-decoration: none;
  }
  .near a:hover { border-color: var(--cyan); background: var(--cyan-50); }
  .near svg { width: 15px; height: 15px; color: var(--red); }

  .near-services h3 { font-size: 1.08rem; margin-bottom: .8rem; }
  .near-services ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: .55rem; }
  @media (max-width: 760px) { .near-services ul { grid-template-columns: 1fr; } }
  .near-services a { display: block; padding: .7rem .9rem; border-radius: 10px; background: #fff; border: 1px solid var(--line); color: var(--ink-2); text-decoration: none; font-weight: 600; font-size: .95rem; }
  .near-services a:hover { border-color: var(--cyan); color: var(--navy); }
</style>
