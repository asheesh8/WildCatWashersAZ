---
/**
 * Community and HOA pages (Doc 3 §9 + the plan's HOA list). Each page leads
 * with a direct answer to "who cleans windows in <place>?", then only what is
 * true of this place: its character, how it differs from its nearest sibling,
 * one service emphasis, the reviews recorded there, and the services those
 * reviews mention. Generic answers live on their own pages and are linked,
 * not repeated (doorway-page guard).
 */
import Base from '@/layouts/Base.astro';
import HeroPostcard from '@/components/r/HeroPostcard.astro';
import NoteCard from '@/components/r/NoteCard.astro';
import RuledList from '@/components/r/RuledList.astro';
import Filmstrip from '@/components/r/Filmstrip.astro';
import PullQuote from '@/components/r/PullQuote.astro';
import { vary, say } from '@/lib/vary';
import TrustRow from '@/components/TrustRow.astro';
import ReviewSetBlock from '@/components/ReviewSetBlock.astro';
import FaqList from '@/components/FaqList.astro';
import Icon from '@/components/Icon.astro';
import { communities, communityBySlug, townBySlug, childrenOf, townHref, communityHref, windowTownSlugs, type Community } from '@/data/areas';
import { planFor } from '@/data/plan';
import { faqRefs, type Faq } from '@/data/faq';
import { ownerLinks, faqOwner } from '@/lib/faqOwner';
import { communityReviews, servicesMentioned, withProof } from '@/lib/local';
import DepthSections from '@/components/DepthSections.astro';
import { depthFor, withDepthFaqs, proofReviews, keptOut } from '@/data/depth';
import { hashSeed } from '@/data/reviews';
import { faqSchema } from '@/lib/schema';
import { company, telHref } from '@/data/business';
import { fitTitle, fitDescription } from '@/lib/seo';
import { communityPhotos } from '@/data/placement';
import { photoTown } from '@/data/media';

export function getStaticPaths() {
  return communities.map((c) => ({ params: { town: c.parent, community: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Community };
const town = townBySlug[c.parent];
const townName = town.name;
const url = communityHref(c);
const row = planFor(url);
const h1 = row?.h1 ?? `Window Cleaning in ${c.name}`;
const d = depthFor(url);
const isOwn = (r: { detail: string; area: string }) => (c.reviewDetails ?? []).includes(r.detail) || (c.reviewAreas ?? []).includes(r.area);
const set = withProof(communityReviews(c, 6, hashSeed(c.slug) % 997), proofReviews(d), isOwn, 6, keptOut(d));
const mentioned = servicesMentioned(set.local);

/* The place's own Doc 6 question (F91–122), plus the HOA answers on HOA pages. */
const refs = withDepthFaqs(faqRefs(row?.faq_refs), d);
const hoaNs = [193, 194, 195];
const hoaFaqs = refs.filter((f) => hoaNs.includes(f.n));
/* Questions another page owns are linked to it, not reprinted here (doorway guard); this page prints its own. */
const sharedQ = (n: number) => Boolean(faqOwner(n)) && faqOwner(n) !== url;
const placeFaqs: Faq[] = refs.filter((f) => !hoaNs.includes(f.n) && !sharedQ(f.n));
const askedElsewhere = refs.filter((f) => !hoaNs.includes(f.n) && sharedQ(f.n)).map((f) => ({ q: f.q, href: faqOwner(f.n)! })).filter((f, i, a) => a.findIndex((x) => x.href === f.href) === i);
const seniorFaqs: Faq[] = [];
const faqLinks = ownerLinks(refs, url);

const siblings = childrenOf(town.slug).filter((s) => s.slug !== c.slug);
/* Hero and gallery come from the shared placement pass: this town's own photos first, spread across the family. */
const photos = communityPhotos(c);
const hero = photos.hero;
const crumbs = [{ name: 'Areas', href: '/areas/' }, { name: townName, href: townHref(town.slug) }, { name: c.name, href: url }];
const townWindow = windowTownSlugs.includes(town.slug) ? `/services/window-cleaning/${town.slug}/` : '/services/window-cleaning/';
const hoaWord = c.hoa ? ' HOA' : '';
const title = d?.title ?? fitTitle([`Window Cleaning ${c.name}${hoaWord}`, `${c.name} Window Cleaning`, `Window Cleaning ${c.name}`]);
const featured = set.local.find((r) => r.text.length >= 90 && r.text.length <= 320);
const restSet = featured ? { ...set, local: set.local.filter((r) => r.n !== featured.n) } : set;
const kindLabel = c.kind === 'hoa' || c.hoa ? 'HOA community' : 'Neighborhood';
/* Sibling variation: photo side, and whether the local conditions or the depth copy comes first. */
const flipHero = vary(url, 2, 'hero') === 1;
const condFirst = vary(url, 2, 'cond') === 1;
/* The link to the town's conditions is on every one of these pages, so its wording changes by page. */
const condLine = vary(url, 3, 'condline');
const townPoss = townName.endsWith('s') ? `${townName}’` : `${townName}’s`;
const description = d?.meta ?? fitDescription(`${c.name}, ${townName}: ${c.lead.replace(/^(Yes|We do|Wildcat Washers)\.\s*/, '')} Call ${company.phone}.`);
---
<Base
  title={title}
  description={description}
  breadcrumbs={crumbs}
  schema={[
    { '@type': 'Service', name: `Window cleaning in ${c.name}`, serviceType: 'Window Cleaning', provider: { '@id': `${company.url}/#business` }, areaServed: { '@type': 'Place', name: c.name, containedInPlace: { '@type': 'Place', name: `${townName.replace(/ AZ$/, '')}, AZ` } }, url: `${company.url}${url}` },
    ...(placeFaqs.length ? [faqSchema(placeFaqs)] : []),
  ]}
  ctaArea={town.slug}
  ctaPlace={c.name}
  noindex={c.pending}
>
  <HeroPostcard title={h1} lede={d?.answer ?? c.lead} crumbs={crumbs} photo={hero} place={c.name} town={townName} kind={kindLabel} ctaHref={`/quote/?area=${town.slug}`} flip={flipHero} />
  <TrustRow tone="light" />

  <section class="section">
    <div class="wrap place">
      <div class="place-copy">
        <h2 class="h2">{c.kind === 'hoa' ? `Serving ${c.name} homeowners${c.hoa ? ' and the HOA' : ''}` : `Window cleaning for ${c.name} homes`}</h2>
        <p class="lede">{c.intro}</p>
        <p class="differs"><Icon name="pin" size={20} /><span>{c.differs}</span></p>
        {mentioned.length > 0 && (
          <p>{c.name} customers have reviewed us for {mentioned.map((m, i) => <>{i > 0 && (i === mentioned.length - 1 ? ' and ' : ', ')}<a href={m.href}>{m.label}</a></>)}. Every window job is our <a href="/services/window-cleaning/">5-in-1 Deep Clean</a>, and you don’t pay until you’re happy.</p>
        )}
        {/* The desert conditions are the town's (community angles are metro-wide), so they live on the town page, linked once here. */}
        <p class="cond-link">{condLine === 0 && <><a href={`${townHref(town.slug)}#conditions`}>What {townPoss} dust and hard water do to glass</a>, and why it calls for the whole window cleaned.</>}{condLine === 1 && <>Dust and hard water are the same here as across {townName}. <a href={`${townHref(town.slug)}#conditions`}>How they mark the glass, and what we do about it</a>.</>}{condLine === 2 && <>Wondering why the spots come back? <a href={`${townHref(town.slug)}#conditions`}>The {townName} dust and water story</a> explains it.</>}</p>
      </div>
      <NoteCard to={`${c.name} homeowners`} title={c.emphasis.title} body={c.emphasis.body} />
    </div>
  </section>


  {d?.sections && <DepthSections sections={d.sections} heading={d.heading ?? `Local to ${c.name}`} tone={condFirst ? 'plain' : 'mist'} mfold />}

  {c.known && c.known.length > 0 && (
    <section class="section-tight" data-mfold>
      <div class="wrap known">
        <h2 class="h3">{c.name} at a glance</h2>
        <ul role="list">{c.known.map((k) => <li><Icon name="home" size={20} /><span>{k}</span></li>)}</ul>
        {c.hoaReview && <p class="hoa-note"><Icon name="shield" size={20} /><span>Solar screens and pigeon mesh change how the outside of a home looks. If {c.name} has architectural review, check with it before an install.</span></p>}
      </div>
    </section>
  )}


  <Filmstrip keys={photos.gallery} title={photos.gallery.some((k) => photoTown[k] === town.slug) ? `More from ${townName} jobs` : say(url, 'film-h', ['Recent jobs across the Tucson area', 'Recent work around Tucson', 'A few of our recent jobs'])} max={3} />

  {c.sections && c.sections.length > 0 && (
    <section class="section-tight" data-mfold>
      <div class="wrap">
        <h2 class="h3" style="margin-bottom:1rem">Also in and around {c.name}</h2>
        <dl class="secs">{c.sections.map((s) => {
          const page = communities.find((x) => x.name === s.name && !x.pending);
          return <div><dt>{page ? <a href={communityHref(page)}>{s.name}</a> : s.name}</dt><dd>{s.body}</dd></div>;
        })}</dl>
      </div>
    </section>
  )}

  {featured && <PullQuote review={featured} heading={`From a ${c.name} customer`} tone={vary(url, 2, 'pq') ? 'blue' : 'mist'} />}
  {(restSet.local.length > 0 || restSet.more.length > 0) && <ReviewSetBlock set={restSet} title={set.count ? say(url, 'rev-h', [`What ${c.name} residents say`, `Reviews from ${c.name}`, `${c.name} customers, in their words`]) : say(url, 'rev-h', [`What ${townName} neighbors say`, `Reviews from around ${townName}`, `From customers near ${c.name}`])} />}

  {hoaFaqs.length > 0 && (
    <section class="section-tight bg-mist" data-mfold>
      <div class="wrap hoa">
        <div>
          <h2 class="h3">{say(url, 'hoa-h', ['For HOA boards: common areas and community buildings', 'On the HOA board?', `Clubhouses and common areas in ${c.name}`])}</h2>
        </div>
        {/* The HOA answers are owned by the HOA page; here they are links, not reprints. */}
        <ul class="hoa-links" role="list">{hoaFaqs.map((f) => <li><a href={faqOwner(f.n) && faqOwner(f.n) !== url ? faqOwner(f.n) : '/who-we-help/hoas-communities/'}>{f.q}<Icon name="arrow" size={20} /></a></li>)}</ul>
        <a class="text-link" href="/who-we-help/hoas-communities/">HOA and community work <Icon name="arrow" size={20} /></a>
      </div>
    </section>
  )}

  {askedElsewhere.length > 0 && (
    <section class="section-tight" data-mfold>
      <div class="wrap">
        <h2 class="h3" style="margin-bottom:.8rem">Questions {c.name} homeowners ask</h2>
        <ul class="hoa-links" role="list">{askedElsewhere.map((f) => <li><a href={f.href}>{f.q}<Icon name="arrow" size={20} /></a></li>)}</ul>
      </div>
    </section>
  )}

  {(placeFaqs.length > 0 || seniorFaqs.length > 0) && <FaqList items={[...placeFaqs, ...seniorFaqs]} links={faqLinks} title={`${c.name} questions`} phoneClosed mfold />}

  <section class="section-tight" data-mfold>
    <div class="wrap">
      <h2 class="h3" style="margin-bottom:1rem">{say(url, 'more-h', [`More in ${townName}`, `Elsewhere in ${townName}`, `Around ${townName}`])}</h2>
      <ul class="chips m-grid" role="list">
        <li><a href={townHref(town.slug)}><Icon name="pin" size={18} />{townName}</a></li>
        <li><a href={townWindow}><Icon name="sparkle" size={18} />Window cleaning in {townName}</a></li>
        {siblings.map((s) => <li><a href={communityHref(s)}><Icon name="home" size={18} />{s.name}</a></li>)}
      </ul>
    </div>
  </section>
</Base>
<style>
  .place { display: grid; gap: clamp(1.6rem, 1rem + 3vw, 3.5rem); }
  @media (min-width: 1000px) { .place { grid-template-columns: 1.3fr 1fr; align-items: start; } }
  .place-copy { display: grid; gap: 1.1rem; }
  .place-copy p:not(.eyebrow):not(.lede) { font-size: 1.12rem; color: var(--ink-2); }
  .differs { display: flex; gap: .6rem; align-items: flex-start; padding: .9rem 0; border-block: 1px solid var(--line-strong); font-weight: 600; color: var(--navy) !important; }
  .differs :global(svg) { flex: none; margin-top: .2rem; color: var(--blue-700); }
  .conds { list-style: none; padding: 0; display: grid; gap: .8rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
  .conds li { display: flex; gap: .7rem; align-items: flex-start; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem 1.1rem; font-size: 1.08rem; color: var(--ink-2); }
  .conds :global(svg) { flex: none; color: var(--blue-700); margin-top: .15rem; }
  .secs { display: grid; gap: 1rem 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .secs dt { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; color: var(--navy); }
  .secs dd { margin: .2rem 0 0; color: var(--ink-2); }
  .known { display: grid; gap: 1.2rem; }
  @media (min-width: 1000px) { .known { grid-template-columns: 1fr 2fr; align-items: start; } .hoa-note { grid-column: 2; } }
  .known ul { list-style: none; padding: 0; display: grid; gap: .7rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .known li { display: flex; gap: .7rem; align-items: flex-start; font-size: 1.1rem; color: var(--ink-2); padding: .9rem 0; border-bottom: 1px solid var(--line-strong); }
  .known li :global(svg), .hoa-note :global(svg) { flex: none; color: var(--blue-700); margin-top: .2rem; }
  .hoa-note { display: flex; gap: .6rem; align-items: flex-start; font-weight: 600; color: var(--navy); }
  .hoa { display: grid; gap: 1.2rem; }
  /* The eyebrow's pull-up margin assumes a 1rem stack gap; without one a two-line eyebrow ran into its heading on phones. */
  :is(.hoa, .known) > div:first-child { display: grid; gap: 1rem; }
  .hoa-links { list-style: none; padding: 0; display: grid; gap: 0 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); }
  .hoa-links a { display: flex; justify-content: space-between; gap: 1rem; align-items: center; min-height: 56px; border-bottom: 1px solid var(--line-strong); font-weight: 700; color: var(--navy); text-decoration: none; font-size: 1.08rem; }
  .hoa-links a :global(svg) { flex: none; color: var(--blue-700); }
  .cond-link a { font-weight: 700; }
  .hoa-list { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); }
  .hoa-list dl { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.2rem 1.3rem; }
  .hoa dt { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; color: var(--navy); margin-bottom: .3rem; }
  .hoa dd { margin: 0; color: var(--ink-2); }
  .hoa .text-link { justify-self: start; }
  /* Phones: the navy "For this community" card a little snugger (same type). */
  @media (max-width: 759px) {
    .differs { padding: .8rem 0; }
    .place-copy { gap: .9rem; }
    .place-copy .lede { font-size: 1.15rem; }
  }
</style>
