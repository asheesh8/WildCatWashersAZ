---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import TrustRow from '@/components/TrustRow.astro';
import Conditions from '@/components/Conditions.astro';
import ReviewSetBlock from '@/components/ReviewSetBlock.astro';
import FaqList from '@/components/FaqList.astro';
import { faqRefs } from '@/data/faq';
import { ownerLinks } from '@/lib/faqOwner';
import Icon from '@/components/Icon.astro';
import { towns, townBySlug, childrenOf, townHref, communityHref, windowTownSlugs, type Town } from '@/data/areas';
import { serviceBySlug, serviceHref } from '@/data/business';
import { img, altFor, focusFor, cropFor } from '@/data/media';
import { townPhotos } from '@/data/placement';
import Gallery from '@/components/Gallery.astro';
import { h1For, planFor } from '@/data/plan';
import { townReviews, withProof } from '@/lib/local';
import DepthSections from '@/components/DepthSections.astro';
import { depthFor, withDepthFaqs, proofReviews, keptOut } from '@/data/depth';
import { hashSeed } from '@/data/reviews';
import { faqSchema } from '@/lib/schema';
import { fitTitle, fitDescription } from '@/lib/seo';

export function getStaticPaths() {
  return towns.map((t) => ({ params: { town: t.slug }, props: { t } }));
}
const { t } = Astro.props as { t: Town };
const url = townHref(t.slug);
const title = h1For(url, `Window cleaning and exterior cleaning in ${t.name}`);
const kids = childrenOf(t.slug);
/* Named sections without a page of their own, listed under the neighborhood links. */
const secs = t.sections.filter((s) => !kids.some((k) => k.name === s.name));
/* Phones show the first four neighborhoods (links, then named sections) before "Show all", when two or more would be tucked away. */
const whereTotal = kids.length + secs.length;
const whereFirst = whereTotal > 5 ? 4 : whereTotal;
const d = depthFor(url);
const set = withProof(townReviews(t, 6, hashSeed(t.slug)), proofReviews(d), (r) => r.area === t.reviewArea, 6, keptOut(d));
const faqs = withDepthFaqs(faqRefs(planFor(url)?.faq_refs), d);
const faqLinks = ownerLinks(faqs, url);
const crumbs = [{ name: 'Areas', href: '/areas/' }, { name: t.name, href: url }];
const photos = townPhotos(t);
const hasWindowPage = windowTownSlugs.includes(t.slug);
const emphasisHref = (slug: string) => (slug === 'window-cleaning' && hasWindowPage ? `/services/window-cleaning/${t.slug}/` : serviceHref(slug));
const place = {
  '@type': 'Place',
  name: `${t.name.replace(/ AZ$/, '')}, AZ`,
  containedInPlace: { '@type': 'State', name: 'Arizona' },
};
---
<Base
  title={d?.title ?? fitTitle([`${t.name} Window, Solar & Exterior Cleaning`, `Exterior Cleaning ${t.name}`])}
  description={d?.meta ?? fitDescription(`Window cleaning, solar panels, solar screens and pressure washing in ${t.name}. ${kids.length ? `Including ${kids.slice(0, 3).map((k) => k.name).join(', ')}. ` : ''}Call (520) 525-0084.`)}
  breadcrumbs={crumbs}
  schema={[{ '@type': 'WebPage', name: title, about: place, url: `https://wildcatwashers.com${url}` }, ...(faqs.length ? [faqSchema(faqs)] : [])]}
  ctaArea={t.slug}
  ctaPlace={t.slug === 'vail-az' ? t.name : t.name.replace(/ AZ$/, '')}
>
  <PageHero eyebrow={`Serving ${t.name}${t.name.endsWith('AZ') ? '' : ', AZ'}`} title={title} lede={d?.answer ?? t.intro} crumbs={crumbs} image={photos.hero} ctaHref={`/quote/?area=${t.slug}`} />
  <TrustRow />

  {d?.sections && <DepthSections sections={d.sections} eyebrow={`About ${t.name}`} heading={d.heading ?? `Serving ${t.name}`} intro={d.answer ? t.intro : undefined} />}

  <Conditions title={`What ${t.name} does to your glass`} items={t.conditions} swipe mfold />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What we do most here</p>
        <h2 class="h2 sweep">Our {t.name} services</h2>
      </div>
      <ul class="emph m-swipe" role="list">
        {t.emphasis.map((e) => {
          const s = serviceBySlug[e.service];
          return (
            <li class="reveal">
              <a href={emphasisHref(e.service)}>
                <span class="emph-img"><Image src={img(s.image)} alt={altFor(s.image)} width={700} height={438} fit="cover" position={cropFor(s.image)} widths={[400, 700]} sizes="(min-width: 900px) 33vw, 100vw" quality={68} style={`object-position:${focusFor(s.image)}`} /></span>
                <span class="emph-body">
                  <span class="h3">{s.name}{e.service === 'window-cleaning' && hasWindowPage ? ` in ${t.name}` : ''}</span>
                  <span>{e.why}</span>
                  <span class="text-link">Learn more <Icon name="arrow" size={18} /></span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
      <p class="also">We also do <a href="/services/screen-repair/">screen repair</a>, <a href="/services/solar-panel-pigeon-proofing/">solar panel pigeon proofing</a>, <a href="/services/pressure-washing/patios-pool-decks/">patio and pool deck washing</a> and every other service in {t.name}.{kids.length > 0 && <> We also work with <a href="/who-we-help/hoas-communities/">HOAs and communities</a>.</>} <a href="/services/">See all services</a>.</p>
    </div>
  </section>

  <Gallery keys={photos.gallery} title="From recent jobs" swipe />

  {(kids.length > 0 || t.sections.length > 0) && (
    <section class="section-tight bg-mist" data-mfold>
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Neighborhoods</p>
          <h2 class="h2">Where we work in {t.name}</h2>
        </div>
        <div class="where" id="where-list">
          {kids.length > 0 && (
            <ul class="kids" role="list">
              {kids.map((c, i) => (
                <li class:list={[i >= whereFirst && 'k-more']}><a href={communityHref(c)}><strong>{c.name}</strong><span>Neighborhood page</span><Icon name="arrow" size={20} /></a></li>
              ))}
            </ul>
          )}
          {secs.length > 0 && (
            <dl class="secs">
              {secs.map((s, j) => (
                <div class:list={[kids.length + j >= whereFirst && 'k-more']}><dt>{s.name}</dt><dd>{s.body}</dd></div>
              ))}
            </dl>
          )}
        </div>
        {whereTotal > whereFirst && (
          <>
            {/* Phones: the first four neighborhoods show and a button opens the rest. Desktop (and no JS) shows all of them. */}
            <button type="button" class="kids-toggle" aria-controls="where-list" aria-expanded="false" hidden><span class="km-open">Show all {whereTotal} neighborhoods</span><span class="km-close">Show fewer neighborhoods</span><Icon name="plus" size={20} /></button>
            <script is:inline>
              (function () {
                var b = document.currentScript && document.currentScript.previousElementSibling, l = document.getElementById('where-list');
                if (!b || !l || !matchMedia('(max-width: 759px)').matches) return;
                l.classList.add('is-short'); b.hidden = false;
                b.addEventListener('click', function () { var o = l.classList.toggle('is-short'); b.setAttribute('aria-expanded', String(!o)); });
              })();
            </script>
          </>
        )}
      </div>
    </section>
  )}

  <ReviewSetBlock set={set} title={set.count ? `What ${t.name} neighbors say` : 'What customers across the metro say'} />

  {faqs.length > 0 && <FaqList items={faqs} links={faqLinks} title={`${t.name} questions`} phoneClosed mfold />}
  <section class="section-tight" data-mfold>
    <div class="wrap diy">
      <p class="eyebrow">Doing it yourself?</p>
      <h2 class="h3">Cleaning your own windows in {t.name}</h2>
      <ul class="chips" role="list">
        <li><a href="/guides/can-i-clean-my-own-windows/"><Icon name="arrow" size={18} />Can I just clean my own windows?</a></li>
        <li><a href="/guides/why-do-windows-look-worse-after-i-clean-them/"><Icon name="arrow" size={18} />Why do my windows look worse after I clean them?</a></li>
        <li><a href="/guides/should-i-hose-off-my-windows/"><Icon name="arrow" size={18} />Should I rinse my windows with a hose?</a></li>
      </ul>
    </div>
  </section>

  <section class="section-tight" data-mfold>
    <div class="wrap">
      <h2 class="h3" style="margin-bottom:1rem">Nearby areas we serve</h2>
      <ul class="chips m-grid" role="list">
        {t.nearby.map((n) => townBySlug[n]).filter(Boolean).map((n) => <li><a href={townHref(n.slug)}><Icon name="pin" size={18} />{n.name}</a></li>)}
        <li><a href="/areas/"><Icon name="plus" size={18} />All areas</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .emph { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .emph a { display: grid; height: 100%; text-decoration: none; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm); transition: transform .3s var(--ease), box-shadow .3s var(--ease); }
  .emph a:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .emph-img { aspect-ratio: 16 / 10; overflow: hidden; }
  .emph-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .emph-body { display: grid; gap: .6rem; padding: 1.4rem; align-content: start; color: var(--ink-2); }
  .emph-body .h3 { color: var(--navy); }
  .emph-body .text-link { justify-self: start; margin-top: .3rem; }
  .also { margin-top: 1.6rem; font-size: 1.1rem; }
  .also a { font-weight: 700; }
  .kids { list-style: none; padding: 0; display: grid; gap: .8rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); margin-bottom: 1.6rem; }
  .kids a { display: grid; grid-template-columns: 1fr auto; gap: 0 1rem; align-items: center; padding: 1.2rem 1.4rem; background: #fff; border: 2px solid var(--line); border-radius: var(--radius); text-decoration: none; }
  .kids a:hover { border-color: var(--blue); }
  .kids strong { font-family: var(--font-display); font-size: 1.25rem; font-weight: 800; }
  .kids span { grid-row: 2; color: var(--ink-3); font-size: 1rem; }
  .kids :global(svg) { grid-row: 1 / 3; grid-column: 2; color: var(--blue-700); }
  /* Phones: neighborhood rows a little snugger, same type, still 60px+ tap targets. */
  @media (max-width: 699px) { .kids { gap: .55rem; margin-bottom: 1.2rem; } .kids a { padding: .75rem 1.1rem; } .kids strong { line-height: 1.25; } }
  .kids-toggle { display: none; }
  @media (max-width: 759px) {
    .where.is-short .k-more { display: none; }
    /* With every named section tucked away, the links row needs no gap under it. */
    .where.is-short .kids:has(+ .secs > .k-more:first-child) { margin-bottom: 0; }
    .where.is-short .secs:not(:has(> :not(.k-more))) { display: none; }
    .where.is-short { margin-bottom: .55rem; }
    .where:not(.is-short) + .kids-toggle { margin-top: 1.2rem; }
    .kids-toggle:not([hidden]) {
      display: flex; width: 100%; align-items: center; justify-content: space-between; gap: .6rem; cursor: pointer;
      min-height: 48px; margin-bottom: 1.2rem; padding: .5rem 1.1rem; border-radius: var(--radius); background: #fff; border: 2px dashed var(--line-strong);
      font: inherit; font-weight: 800; color: var(--navy); text-align: left;
    }
    .kids-toggle .km-close, .kids-toggle[aria-expanded='true'] .km-open { display: none; }
    .kids-toggle[aria-expanded='true'] .km-close { display: inline; }
    .kids-toggle :global(svg) { flex: none; color: var(--blue-700); transition: rotate .25s var(--ease); }
    .kids-toggle[aria-expanded='true'] :global(svg) { rotate: 45deg; }
    /* The service cards' photos run a little shorter. */
    .emph-img { aspect-ratio: 2 / 1; }
    .emph-body { padding: 1.1rem 1.2rem 1.2rem; gap: .5rem; }
    .also { margin-top: 1.2rem; }
  }
  @media (prefers-reduced-motion: reduce) { .kids-toggle :global(svg) { transition: none; } }
  .secs { display: grid; gap: 1rem 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .secs dt { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; color: var(--navy); }
  .secs dd { margin: .2rem 0 0; color: var(--ink-2); }
  .diy { display: grid; gap: .7rem; }
</style>
