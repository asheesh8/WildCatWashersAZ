---
import Base from '@/layouts/Base.astro';
import HeroPlace from '@/components/r/HeroPlace.astro';
import WhoComes from '@/components/r/WhoComes.astro';
import RuledList from '@/components/r/RuledList.astro';
import ZigZag from '@/components/r/ZigZag.astro';
import Filmstrip from '@/components/r/Filmstrip.astro';
import Directory from '@/components/r/Directory.astro';
import PullQuote from '@/components/r/PullQuote.astro';
import { vary, say } from '@/lib/vary';
import TrustRow from '@/components/TrustRow.astro';
import ReviewSetBlock from '@/components/ReviewSetBlock.astro';
import FaqList from '@/components/FaqList.astro';
import { faqRefs } from '@/data/faq';
import { ownerLinks, faqOwner } from '@/lib/faqOwner';
import Icon from '@/components/Icon.astro';
import { towns, townBySlug, childrenOf, townHref, communityHref, windowTownSlugs, type Town } from '@/data/areas';
import { serviceBySlug, serviceHref } from '@/data/business';
import { photoTown, photoKind, sceneOf } from '@/data/media';
import { townPhotos } from '@/data/placement';
import { h1For, planFor } from '@/data/plan';
import { townReviews, withProof } from '@/lib/local';
import DepthSections from '@/components/DepthSections.astro';
import { depthFor, withDepthFaqs, proofReviews, keptOut } from '@/data/depth';
import { hashSeed } from '@/data/reviews';
import { faqSchema } from '@/lib/schema';
import { fitTitle, fitDescription } from '@/lib/seo';

export function getStaticPaths() {
  return towns.map((t) => ({ params: { town: t.slug }, props: { t } }));
}
const { t } = Astro.props as { t: Town };
const url = townHref(t.slug);
const title = h1For(url, `Window cleaning and exterior cleaning in ${t.name}`);
const kids = childrenOf(t.slug);
/* Named sections without a page of their own, listed under the neighborhood links. */
const secs = t.sections.filter((s) => !kids.some((k) => k.name === s.name));
/* Phones show the first four neighborhoods (links, then named sections) before "Show all", when two or more would be tucked away. */
const whereTotal = kids.length + secs.length;
const whereFirst = whereTotal > 5 ? 4 : whereTotal;
const d = depthFor(url);
const set = withProof(townReviews(t, 6, hashSeed(t.slug)), proofReviews(d), (r) => r.area === t.reviewArea, 6, keptOut(d));
const allFaqs = withDepthFaqs(faqRefs(planFor(url)?.faq_refs), d);
/* Questions another page owns are linked, not reprinted (doorway guard). */
const sharedQ = (n: number) => Boolean(faqOwner(n)) && faqOwner(n) !== url;
const faqs = allFaqs.filter((f) => !sharedQ(f.n));
const askedElsewhere = allFaqs.filter((f) => sharedQ(f.n)).map((f) => ({ q: f.q, href: faqOwner(f.n)! })).filter((f, i, a) => a.findIndex((x) => x.href === f.href) === i);
const faqLinks = ownerLinks(faqs, url);
const crumbs = [{ name: 'Areas', href: '/areas/' }, { name: t.name, href: url }];
const photos = townPhotos(t);
const hasWindowPage = windowTownSlugs.includes(t.slug);
const emphasisHref = (slug: string) => (slug === 'window-cleaning' && hasWindowPage ? `/services/window-cleaning/${t.slug}/` : serviceHref(slug));
/* Redesign: strip of three, one photo per service row (matching the service), the rest as a filmstrip. */
const pool = [photos.hero, ...photos.gallery];
/* The hero strip shows this town's own jobs (or untagged ones) before another town's. */
const isLocal = (x: string) => !photoTown[x] || photoTown[x] === t.slug;
const strip = [...pool.filter(isLocal), ...pool.filter((x) => !isLocal(x))].slice(0, 3);
const svcKinds: Record<string, string[]> = { 'window-cleaning': ['window-action', 'window-result'], 'solar-panel-cleaning': ['solar'], 'solar-screens': ['screens'], 'pressure-washing': ['pressure'], 'screen-repair': ['screens', 'pressure'] };
const usedScenes = new Set(strip.map(sceneOf));
const rowPhoto = (svc: string) => {
  const k = pool.filter((x) => !strip.includes(x)).find((x) => (svcKinds[svc] ?? []).includes(photoKind[x]) && !usedScenes.has(sceneOf(x)) && (!photoTown[x] || photoTown[x] === t.slug))
    ?? (usedScenes.has(sceneOf(serviceBySlug[svc].image)) ? undefined : serviceBySlug[svc].image);
  if (k) usedScenes.add(sceneOf(k));
  return k;
};
const rows = t.emphasis.map((e) => {
  const s = serviceBySlug[e.service];
  return { title: `${s.name}${e.service === 'window-cleaning' && hasWindowPage ? ` in ${t.name}` : ''}`, body: e.why, photo: rowPhoto(e.service), href: emphasisHref(e.service), linkLabel: `More on ${s.name.toLowerCase()}` };
});
const film = pool.filter((k) => !usedScenes.has(sceneOf(k)));
const whereTotalUnused = whereTotal + whereFirst;
/* The featured review: a local one short enough to set large, else none. */
const featured = set.local.find((r) => r.text.length >= 90 && r.text.length <= 320);
const restSet = featured ? { ...set, local: set.local.filter((r) => r.n !== featured.n) } : set;
/* Sibling variation: half the towns put their reviews before the neighborhood index. */
const reviewsFirst = vary(url, 2, 'rev') === 1;
const place = {
  '@type': 'Place',
  name: `${t.name.replace(/ AZ$/, '')}, AZ`,
  containedInPlace: { '@type': 'State', name: 'Arizona' },
};
/* Half the towns lead with the work we do there, then what the desert does to the glass. */
const workFirst = vary(url, 2, 'workfirst') === 1;
const revTitle = set.count ? say(url, 'rev-h', [`What ${t.name} neighbors say`, `Reviews from ${t.name}`, `${t.name} customers, in their words`]) : say(url, 'rev-h', ['What customers across the metro say', 'Reviews from around Tucson', 'What Tucson-area customers say']);
---
<Base
  title={d?.title ?? fitTitle([`${t.name} Window, Solar & Exterior Cleaning`, `Exterior Cleaning ${t.name}`])}
  description={d?.meta ?? fitDescription(`Window cleaning, solar panels, solar screens and pressure washing in ${t.name}. ${kids.length ? `Including ${kids.slice(0, 3).map((k) => k.name).join(', ')}. ` : ''}Call (520) 525-0084.`)}
  breadcrumbs={crumbs}
  schema={[{ '@type': 'WebPage', name: title, about: place, url: `https://wildcatwashers.com${url}` }, ...(faqs.length ? [faqSchema(faqs)] : [])]}
  ctaArea={t.slug}
  ctaPlace={t.slug === 'vail-az' ? t.name : t.name.replace(/ AZ$/, '')}
>
  <HeroPlace title={title} place={t.name} lede={d?.answer ?? t.intro} crumbs={crumbs} photos={strip} ctaHref={`/quote/?area=${t.slug}`} />
  <TrustRow />

  {d?.sections && <DepthSections sections={d.sections} variant="prose" heading={d.heading ?? `${t.name}, up close`} intro={d.answer ? t.intro : undefined} mfold />}

  {!workFirst && <RuledList title={`What ${t.name} does to your glass`} items={t.conditions} mfold id="conditions" />}

  <ZigZag title={`What we do most in ${t.name}`} rows={rows} startRight={vary(url, 2, 'zz') === 1} />
  <section class="section-tight also-sec">
    <div class="wrap">
      <p class="also">We also do <a href="/services/screen-repair/">screen repair</a>, <a href="/services/solar-panel-pigeon-proofing/">solar panel pigeon proofing</a>, <a href="/services/pressure-washing/patios-pool-decks/">patio and pool deck washing</a> and every other service in {t.name}.{kids.length > 0 && <> We also work with <a href="/who-we-help/hoas-communities/">HOAs and communities</a>.</>} <a href="/services/">See all services</a>.</p>
    </div>
  </section>

  {workFirst && <RuledList title={`What ${t.name} does to your glass`} items={t.conditions} mfold id="conditions" />}

  <WhoComes url={url} area={t.reviewArea} avoid={[...set.local, ...set.more].map((r) => r.n)} tone="mist" />

  {reviewsFirst && featured && <PullQuote review={featured} heading={`${/^[AEIOU]/.test(t.name) ? "An" : "A"} ${t.name} customer`} />}
  {reviewsFirst && <ReviewSetBlock set={restSet} title={revTitle} />}

  <Filmstrip keys={film} title={film.some((k) => photoTown[k] === t.slug) ? `More from ${t.name} jobs` : say(url, 'film-h', ['Recent jobs across the Tucson area', 'Recent work around Tucson', 'A few of our recent jobs'])} max={4} />

  {(kids.length > 0 || secs.length > 0) && (
    <Directory title={`Where we work in ${t.name}`} links={kids.map((c) => ({ name: c.name, href: communityHref(c) }))} named={secs} id="where" />
  )}

  {!reviewsFirst && featured && <PullQuote review={featured} heading={`${/^[AEIOU]/.test(t.name) ? "An" : "A"} ${t.name} customer`} tone="mist" />}
  {!reviewsFirst && <ReviewSetBlock set={restSet} title={revTitle} />}

  {faqs.length > 0 && <FaqList items={faqs} links={faqLinks} title={`${t.name} questions`} phoneClosed mfold />}
  <section class="section-tight bg-mist" data-mfold>
    <div class="wrap diy">
      <h2 class="h3">{say(url, 'diy-h', [`More answers for ${t.name} homeowners`, 'Doing it yourself?', 'Before you grab a squeegee'])}</h2>
      <ul class="diy-list" role="list">
        <li><a href="/guides/can-i-clean-my-own-windows/">Can I just clean my own windows?<Icon name="arrow" size={20} /></a></li>
        <li><a href="/guides/why-do-windows-look-worse-after-i-clean-them/">Why do my windows look worse after I clean them?<Icon name="arrow" size={20} /></a></li>
        <li><a href="/guides/should-i-hose-off-my-windows/">Should I rinse my windows with a hose?<Icon name="arrow" size={20} /></a></li>
        {askedElsewhere.filter((f) => !['/guides/can-i-clean-my-own-windows/', '/guides/why-do-windows-look-worse-after-i-clean-them/', '/guides/should-i-hose-off-my-windows/'].includes(f.href)).map((f) => <li><a href={f.href}>{f.q}<Icon name="arrow" size={20} /></a></li>)}
      </ul>
    </div>
  </section>

  <section class="section-tight" data-mfold>
    <div class="wrap">
      <h2 class="h3" style="margin-bottom:1rem">{say(url, 'near-h', ['Nearby areas we serve', `Close to ${t.name}`, 'We also work next door'])}</h2>
      <ul class="chips m-grid" role="list">
        {t.nearby.map((n) => townBySlug[n]).filter(Boolean).map((n) => <li><a href={townHref(n.slug)}><Icon name="pin" size={18} />{n.name}</a></li>)}
        <li><a href="/areas/"><Icon name="plus" size={18} />All areas</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .also-sec { padding-top: 0; }
  .also { font-size: 1.1rem; color: var(--ink-2); max-width: 70ch; padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .also a { font-weight: 700; }
  .diy { display: grid; gap: .9rem; }
  .diy-list { list-style: none; padding: 0; display: grid; gap: 0 2.4rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
  .diy-list a { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 56px; border-bottom: 1px solid var(--line-strong); font-weight: 700; color: var(--navy); text-decoration: none; font-size: 1.08rem; }
  .diy-list a :global(svg) { flex: none; color: var(--blue-700); }
  .diy-list a:hover { color: var(--blue-700); }
  @media (max-width: 759px) { .also { font-size: 1rem; padding-top: 1rem; } }
</style>
