---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import WildcatPromise from '@/components/Promise.astro';
import FaqList from '@/components/FaqList.astro';
import LinkChips from '@/components/LinkChips.astro';
import WhyGrid from '@/components/WhyGrid.astro';
import { protection } from '@/data/business';
import { faqList } from '@/data/faq';
import { h1For } from '@/data/plan';
import { faqSchema } from '@/lib/schema';
const crumbs = [{ name: 'Our guarantees', href: '/guarantee/' }];
const faqs = faqList([208, 186, 187, 188, 152, 150]);
---
<Base title="Our Guarantees: Pay Only When Happy | Wildcat Washers" description="100% Satisfaction Guarantee: payment comes after the walkthrough, only once you’re happy. 14-Day Spotless Guarantee: any touch-up, any reason, free." breadcrumbs={crumbs} schema={[faqSchema(faqs)]}>
  <PageHero eyebrow="No risk, in writing" title={h1For('/guarantee/', 'Our Guarantees')} lede="Payment comes last, after the walkthrough, and only once you’re happy. Then for 14 days, any touch-up for any reason is free. If anything isn’t right, we fix it, no argument." crumbs={crumbs} image="clean-window-sunset-glow" />
  <WildcatPromise />
  <WhyGrid eyebrow="Every visit" title="How we protect your home" items={protection.map((p) => ({ title: p, body: '' }))} />
  <LinkChips title="See what the guarantee covers" links={[{ href: '/services/window-cleaning/', label: 'Window cleaning, the 5-in-1 Deep Clean' }, { href: '/reviews/', label: 'Read our reviews' }, { href: '/how-it-works/', label: 'How a visit works' }]} />
  <FaqList items={faqs} title="Guarantee questions" />
</Base>
