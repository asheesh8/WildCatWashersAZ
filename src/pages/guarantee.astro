---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import PromiseBlocks from '@/components/PromiseBlocks.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import CtaBand from '@/components/CtaBand.astro';
import { guarantees, objections, safety, faqById, company, proof } from '@/data/business';
import { img, altFor } from '@/data/media';

const gFaqs = ['guarantee', 'damage', 'insured', 'payment', 'rain-again', 'trust-in-home'].map((id) => faqById[id]).filter(Boolean);
const schema = [{
  '@type': 'FAQPage',
  mainEntity: gFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}];
---
<Base
  title="Our Guarantees | You Don't Pay Until You're Happy | Wildcat Washers"
  description="Two guarantees behind every Wildcat Washers job: you don't pay until you're happy, and a 10-Day Rainproof Guarantee on exterior glass. Here's exactly what each one covers."
  canonical="/guarantee/"
  schema={schema}
  breadcrumbs={[{ name: 'Our Guarantees', href: '/guarantee/' }]}
>
  <section class="hub tone-navy">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">Our Guarantees</span></nav>
      <h1>There is almost <span class="swipe">no way</span> to lose here.</h1>
      <p class="lede">
        Two guarantees, in plain words, with no small print underneath them. This page exists so
        you know exactly what you are agreeing to before you agree to it.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="gcards">
        {guarantees.map((g, i) => (
          <article class="gcard">
            <span class="gcard-n">.0{i + 1}</span>
            <h2>{g.name}</h2>
            <p class="gcard-head">{g.headline}</p>
            <p class="gcard-body">{g.body}</p>
            <dl>
              <div><dt>What it covers</dt><dd>{g.covers}</dd></div>
              <div><dt>How long</dt><dd>{g.period}</dd></div>
              <div><dt>How to claim</dt><dd>{g.howToClaim}</dd></div>
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section tone-soft">
    <div class="wrap">
      <SectionHead eyebrow="The whole arrangement" title="Four steps, and you are covered at every one." />
      <PromiseBlocks />
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div>
        <SectionHead eyebrow="Before it needs claiming" title="How we avoid needing the guarantee at all." lede="A guarantee is a safety net. The work is what keeps you off it." />
        <ul class="safety">{safety.map((s) => <li><h3>{s.title}</h3><p>{s.body}</p></li>)}</ul>
      </div>
      <figure class="fig">
        <Image src={img('two-techs-window-ladder')} alt={altFor('two-techs-window-ladder')} widths={[420, 780]} sizes="(max-width: 900px) 92vw, 40vw" quality={76} class="cover" />
        <figcaption>Licensed and insured. BBB accredited. {proof.customersServedLabel} customers and no review below five stars.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section tone-soft">
    <div class="wrap">
      <SectionHead eyebrow="Straight answers" title="The things people worry about." />
      <ul class="objs">
        {objections.map((o) => (
          <li><h3>{o.q}</h3><p>{o.a}</p><p class="objs-proof">{o.proof}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap faq-wrap">
      <SectionHead eyebrow="Questions" title="About the guarantees." />
      <FaqAccordion items={gFaqs} />
    </div>
  </section>

  <CtaBand title="Nothing to lose. Book it." />
</Base>

<style>
  .hub { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .hub h1 { font-size: var(--step-4); color: #fff; margin-block: .6rem .8rem; text-transform: none; }
  .hub h1 .swipe::after { background: var(--cyan); opacity: .95; height: .15em; }
  .hub .lede { max-width: 62ch; }
  .crumbs { font-size: .85rem; color: #9fadcb; display: flex; gap: .4rem; }
  .crumbs a { color: #cfd8ec; text-decoration: none; }
  .crumbs span[aria-current] { color: #fff; font-weight: 600; }

  .gcards { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.25rem, 3vw, 2rem); }
  @media (max-width: 860px) { .gcards { grid-template-columns: 1fr; } }
  .gcard { background: #fff; border: 1px solid var(--line); border-top: 4px solid var(--cyan); border-radius: var(--radius-lg); padding: clamp(1.6rem, 3vw, 2.2rem); }
  .gcard-n { font-family: var(--font-display); font-weight: 900; color: var(--cyan-600); font-size: 1rem; }
  .gcard h2 { font-size: var(--step-2); margin-block: .4rem .6rem; }
  .gcard-head { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; color: var(--navy); line-height: 1.35; margin-bottom: .8rem; }
  .gcard-body { color: var(--ink-2); line-height: 1.65; }
  .gcard dl { margin-top: 1.5rem; padding-top: 1.4rem; border-top: 1px solid var(--line); display: grid; gap: 1rem; }
  .gcard dt { font-size: .74rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); margin-bottom: .2rem; }
  .gcard dd { margin: 0; color: var(--ink-2); font-size: .96rem; line-height: 1.55; }

  .two { display: grid; grid-template-columns: 1.2fr .8fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 900px) { .two { grid-template-columns: 1fr; } }
  .safety { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  @media (max-width: 620px) { .safety { grid-template-columns: 1fr; } }
  .safety li { padding-top: 1rem; border-top: 2px solid var(--cyan); }
  .safety h3 { font-size: 1.05rem; margin-bottom: .3rem; }
  .safety p { color: var(--ink-2); font-size: .95rem; line-height: 1.6; }
  .fig { margin: 0; }
  .fig :global(img) { width: 100%; border-radius: var(--radius-lg); aspect-ratio: 4/5; object-fit: cover; }
  .fig figcaption { margin-top: .7rem; font-size: .9rem; color: var(--ink-3); line-height: 1.5; }

  .objs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.25rem, 3vw, 2rem); }
  @media (max-width: 820px) { .objs { grid-template-columns: 1fr; } }
  .objs li { padding-left: 1.2rem; border-left: 3px solid var(--line); }
  .objs h3 { font-size: 1.12rem; text-transform: none; letter-spacing: -.02em; margin-bottom: .35rem; }
  .objs p { color: var(--ink-2); line-height: 1.6; font-size: .98rem; }
  .objs-proof { margin-top: .4rem; font-size: .87rem !important; font-weight: 700; color: var(--cyan-600) !important; }
  .faq-wrap { max-width: 900px; }
</style>
