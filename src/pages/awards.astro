---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { Image } from 'astro:assets';
import { awards, press, proof } from '@/data/business';
import { img, altFor } from '@/data/media';
import { h1For } from '@/data/plan';
const crumbs = [{ name: 'Awards', href: '/awards/' }];
---
<Base title="Awards & Recognition | Wildcat Washers, Tucson’s Readers’ Choice Window Cleaners" description="2026 Arizona Daily Star Readers’ Choice Winner for Best Window Cleaning, 2025 AZ-19 Readers’ Pick, Nextdoor Neighborhood Fave, Angi Super Service Award, Thumbtack Top Pro, BBB accredited." breadcrumbs={crumbs}>
  <PageHero eyebrow="Independent recognition" title={h1For('/awards/', 'Awards and Recognition')} lede="Separate platforms, separate voters, the same result. In under two years we went from founding to the community’s number one pick for window cleaning in Tucson." crumbs={crumbs} image="award-az19-winner-2025" />
  <section class="section">
    <div class="wrap">
      <ul class="aw" role="list">
        {awards.map((a) => (
          <li class="reveal">
            <div class="aw-badge">
              {a.badge ? <img src={a.badge} alt={`${a.issuer} ${a.title}`} width="140" height="140" loading="lazy" /> : <span class="aw-tile"><Icon name="award" size={40} /><b>{a.year}</b><small>Winner</small></span>}
            </div>
            <div>
              <p class="eyebrow">{a.issuer}{a.year ? ` · ${a.year}` : ''}</p>
              <h2 class="h3">{a.title}</h2>
              <p class="aw-d">{a.detail}</p>
              {a.note && <p class="muted">{a.note}</p>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section bg-navy">
    <div class="wrap press">
      <div>
        <p class="eyebrow">In the press</p>
        <h2 class="h2">{press.outlet}</h2>
        <p class="lede">“{press.title}” by {press.author}.</p>
        <blockquote class="press-q">“{press.quote}”</blockquote>
      </div>
      <div class="photo" style="aspect-ratio:4/3"><Image src={img('award-presentation-team')} alt={altFor('award-presentation-team')} widths={[480, 800]} sizes="(min-width: 1000px) 45vw, 100vw" quality={70} /></div>
    </div>
  </section>
  <section class="section-tight"><div class="wrap center"><p class="lede" style="margin-inline:auto">{proof.approvedLine}</p><p style="margin-top:1rem"><a class="text-link" href="/reviews/">Read the reviews <Icon name="arrow" size={20} /></a></p></div></section>
</Base>
<style>
  .aw { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); }
  .aw > li { display: grid; grid-template-columns: 120px 1fr; gap: 1.4rem; align-items: start; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 1.6rem; box-shadow: var(--shadow-sm); }
  .aw-badge img { width: 120px; height: 120px; object-fit: contain; }
  .aw-tile { width: 120px; height: 120px; border-radius: 50%; background: var(--navy); color: var(--gold); display: grid; place-items: center; align-content: center; text-align: center; }
  .aw-tile b { color: #fff; font-family: var(--font-display); font-size: 1.5rem; line-height: 1; }
  .aw-tile small { color: var(--blue); font-weight: 800; text-transform: uppercase; letter-spacing: .1em; }
  .aw-d { font-weight: 700; color: var(--navy); margin: .3rem 0; }
  .press { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 1000px) { .press { grid-template-columns: 1.1fr 1fr; } }
  .press .eyebrow { color: var(--blue); }
  .press-q { font-family: var(--font-display); font-weight: 800; font-size: var(--step-2); line-height: 1.2; margin-top: 1.4rem; color: var(--blue); }
  .press :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
