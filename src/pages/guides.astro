---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { faqCategories, faqs } from '@/data/faq';
import { services, serviceHref } from '@/data/business';
import { h1For } from '@/data/plan';
const crumbs = [{ name: 'Guides and answers', href: '/guides/' }];
const slug = (c: string) => c.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---
<Base title="Guides & Answers: Window, Solar & Exterior Care in Tucson | Wildcat Washers" description="Straight answers about keeping Tucson windows, solar panels, screens and patios clean, from the crew that does it every day." breadcrumbs={crumbs}>
  <PageHero eyebrow="Learn before you book" title={h1For('/guides/', 'Guides and Answers')} lede="Everything we get asked about desert dust, hard water, solar panels, screens and scheduling, answered plainly." crumbs={crumbs} rating={false} />
  <section class="section-tight">
    <div class="wrap">
      <ul class="topics" role="list">
        {faqCategories.map((c) => (
          <li><a href={`/faq/#${slug(c)}`}><strong>{c}</strong><span>{faqs.filter((f) => f.category === c).length} answers</span><Icon name="arrow" size={20} /></a></li>
        ))}
      </ul>
      <h2 class="h3" style="margin:2.4rem 0 1rem">Service guides</h2>
      <ul class="chips" role="list">{services.map((s) => <li><a href={serviceHref(s.slug)}>{s.name}</a></li>)}</ul>
    </div>
  </section>
</Base>
<style>
  .topics { list-style: none; padding: 0; display: grid; gap: .8rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .topics a { display: grid; grid-template-columns: 1fr auto; padding: 1.3rem 1.4rem; border: 2px solid var(--line); border-radius: var(--radius); text-decoration: none; background: #fff; }
  .topics a:hover { border-color: var(--blue); }
  .topics strong { font-family: var(--font-display); font-weight: 800; font-size: 1.2rem; }
  .topics span { color: var(--ink-3); grid-row: 2; }
  .topics :global(svg) { grid-row: 1 / 3; grid-column: 2; align-self: center; color: var(--blue-700); }
</style>
