---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { faqs, faqCategories } from '@/data/faq';
import { h1For } from '@/data/plan';
import { faqSchema } from '@/lib/schema';
import { ownerLinks } from '@/lib/faqOwner';
const crumbs = [{ name: 'FAQ', href: '/faq/' }];
const links = ownerLinks(faqs, '/faq/');
const slug = (c: string) => c.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---
<Base title="Window Cleaning FAQ: Straight Answers | Wildcat Washers" description="Straight answers on window cleaning, solar panels, solar screens, pressure washing, pricing, scheduling and our guarantees in Tucson." breadcrumbs={crumbs} schema={[faqSchema(faqs)]}>
  <PageHero eyebrow={`${faqs.length} answers`} title={h1For('/faq/', 'Frequently Asked Questions')} lede="Honest answers to what people actually ask us. Don’t see yours? Call, and a real person will answer it." crumbs={crumbs} rating={false} />
  <section class="section-tight">
    <div class="wrap faq-layout">
      <nav class="toc" aria-label="FAQ topics">
        <p class="eyebrow">Topics</p>
        <ul role="list">{faqCategories.map((c) => <li><a href={`#${slug(c)}`}>{c}</a></li>)}</ul>
      </nav>
      <div>
        {faqCategories.map((c) => (
          <details id={slug(c)} class="cat" open data-cat>
            <summary class="cat-sum"><h2 class="h3">{c}</h2><span class="cat-n">{faqs.filter((f) => f.category === c).length}</span></summary>
            {faqs.filter((f) => f.category === c).map((f) => (
              <details id={`q${f.n}`} class="q"><summary>{f.q}</summary><p>{f.a}</p>{links[f.n] && <a class="q-more" href={links[f.n].href}>{links[f.n].label}</a>}</details>
            ))}
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
<script is:inline>
  // Phones: topics start closed so the page is a short list; a link to a topic or question opens it.
  (() => {
    const cats = document.querySelectorAll('[data-cat]');
    const openFor = () => { const t = location.hash && document.getElementById(location.hash.slice(1)); if (!t) return; const c = t.closest('[data-cat]'); if (c) c.open = true; if (t.matches('.q')) t.open = true; t.scrollIntoView(); };
    if (matchMedia('(max-width: 999px)').matches) cats.forEach((c) => { c.open = false; });
    openFor();
    addEventListener('hashchange', openFor);
  })();
</script>
<style>
  .faq-layout { display: grid; gap: 2rem; }
  @media (min-width: 1000px) { .faq-layout { grid-template-columns: 280px 1fr; } .toc { position: sticky; top: 110px; align-self: start; } }
  .toc ul { list-style: none; padding: 0; display: grid; gap: .2rem; margin-top: .6rem; }
  .toc a { display: block; padding: .4rem 0; font-weight: 650; text-decoration: none; color: var(--ink-2); }
  .toc a:hover { color: var(--navy); text-decoration: underline; }
  @media (max-width: 999px) { .toc { display: none; } }
  .cat { margin-bottom: 1rem; scroll-margin-top: 110px; border: 2px solid var(--line); border-radius: var(--radius); background: #fff; padding: 0 1.2rem; }
  .cat[open] { border-color: var(--blue); padding-bottom: .6rem; }
  .cat-sum { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.1rem 0; }
  .cat-sum::-webkit-details-marker { display: none; }
  .cat-sum h2 { margin: 0; }
  .cat-n { flex: none; min-width: 2.4rem; text-align: center; padding: .2rem .6rem; border-radius: 99px; background: var(--blue-50); color: var(--navy); font-weight: 800; }
  .q { border-top: 1px solid var(--line); scroll-margin-top: 110px; }
  .q summary { cursor: pointer; padding: 1rem 0; font-weight: 750; font-size: 1.15rem; color: var(--navy); }
  .q p { padding: 0 0 .8rem; color: var(--ink-2); max-width: 70ch; }
  .q-more { display: inline-block; margin: 0 0 1.1rem; font-weight: 700; }
</style>
