---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import HomeHero from '@/components/HomeHero.astro';
import ProofBand from '@/components/ProofBand.astro';
import ReviewTicker from '@/components/ReviewTicker.astro';
import ServiceGrid from '@/components/ServiceGrid.astro';
import FiveInOne from '@/components/FiveInOne.astro';
import WildcatPromise from '@/components/Promise.astro';
import ReviewCard from '@/components/ReviewCard.astro';
import ClubBlock from '@/components/ClubBlock.astro';
import AreaTurf from '@/components/AreaTurf.astro';
import FaqList from '@/components/FaqList.astro';
import Icon from '@/components/Icon.astro';
import { company, proof, press } from '@/data/business';
import { featured, arroyoGardens, displayName, placeLabel } from '@/data/reviews';
import { faqList } from '@/data/faq';
import { img, altFor } from '@/data/media';
import { faqSchema } from '@/lib/schema';

const homeFaq = faqList([25, 159, 201, 152, 144]);
const lead = featured.anneWebb;
const more = featured.home.filter((r) => r.n !== lead.n).slice(0, 6);
---
<Base
  title="Wildcat Washers | Tucson Window & Exterior Cleaning"
  description={`Tucson’s 2026 Readers’ Choice window cleaners. Windows, solar panels, solar screens and pressure washing. ${proof.reviews} five-star reviews. ${company.phone}.`}
  overlay
  schema={[faqSchema(homeFaq)]}
>
  <HomeHero />
  <ProofBand />
  <ReviewTicker />

  <section class="section" aria-labelledby="services-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What we clean</p>
        <h2 id="services-title" class="h2 sweep">Everything outside,<br /><span class="accent">cleaned by hand</span></h2>
        <p class="lede">Six services, one crew, one visit if you like. Background-checked, uniformed technicians, with shoe covers on before anyone steps inside.</p>
      </div>
      <ServiceGrid />
    </div>
  </section>

  <FiveInOne />

  <WildcatPromise collapse />

  <section class="section" aria-labelledby="reviews-title">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">{proof.reviewsLong}</p>
        <h2 id="reviews-title" class="h2 sweep">Neighbors say it better</h2>
      </div>
      <!-- One grid: the lead quote beside four cards on desktop; on phones all five share one swipe row. -->
      <div class="rev-layout m-swipe">
        <figure class="rev-lead reveal">
          <span class="rev-quote" aria-hidden="true">“</span>
          <blockquote><p class:list={[lead.text.length > 150 && 'is-long']}>{lead.text}</p></blockquote>
          {lead.text.length > 150 && <button type="button" class="more-btn" aria-expanded="false">Read the whole review</button>}
          <figcaption><strong>{displayName(lead)}</strong> · {placeLabel(lead)} · {lead.platform}</figcaption>
        </figure>
        {more.slice(0, 4).map((r) => <ReviewCard review={r} />)}
      </div>
      <figure class="rev-inst reveal">
        <blockquote><p class:list={[arroyoGardens.quote.length > 180 && 'is-long']}>“{arroyoGardens.quote}”</p></blockquote>
        {arroyoGardens.quote.length > 180 && <button type="button" class="more-btn" aria-expanded="false">Read the whole review</button>}
        <figcaption><strong>{arroyoGardens.name}</strong><span>{arroyoGardens.role}</span></figcaption>
      </figure>
      <div class="cta-row center rev-all">
        <a class="btn btn-lg btn-white" href="/reviews/"><span>Read all {proof.reviews} reviews</span><span class="chip"><Icon name="arrow" /></span></a>
      </div>
    </div>
  </section>

  <ClubBlock collapse />

  <section class="section bg-mist story" aria-labelledby="story-title">
    <div class="wrap story-grid">
      <div class="story-photos">
        <div class="photo sp-1"><Image src={img('crew-chamber-of-commerce')} alt={altFor('crew-chamber-of-commerce')} widths={[480, 800, 1100]} sizes="(min-width: 1000px) 45vw, 100vw" quality={70} /></div>
        <div class="photo sp-2"><Image src={img('crew-firefighters-santa-rita')} alt={altFor('crew-firefighters-santa-rita')} widths={[400, 640]} sizes="(min-width: 1000px) 25vw, 60vw" quality={70} /></div>
      </div>
      <div class="story-copy">
        <p class="eyebrow">Local, and it shows</p>
        <h2 id="story-title" class="h2 sweep">Founded in {company.founded}. Voted Tucson’s best in under two years.</h2>
        <p class="lede">{company.founders.join(' and ')} built Wildcat Washers around one idea: set a new standard for blue collar. Show up when promised, communicate clearly, do the work thoroughly and leave nothing behind. A small, highly trained team led by crew leaders {company.crewLeaders.join(' and ')} does exactly that.</p>
        <p>Through <a href="/wash-it-forward/">Wash It Forward</a> we clean for the people who look after our community, starting with the Santa Rita Fire Department in Green Valley. And KGVY’s Spring Home &amp; Life 2026 called us “{press.quote.replace(/\.$/, '')}.”</p>
        <div class="cta-row">
          <a class="text-link" href="/about/">Meet the crew <Icon name="arrow" size={20} /></a>
          <a class="text-link" href="/awards/">See our awards <Icon name="arrow" size={20} /></a>
          <a class="text-link" href="/how-it-works/">How a visit works <Icon name="arrow" size={20} /></a>
        </div>
      </div>
    </div>
  </section>

  <AreaTurf />
  <FaqList items={homeFaq} title="Good questions, straight answers" openFirst={false}>
    <p class="center" style="margin-top:1.6rem"><a class="text-link" href="/faq/">See all our answers <Icon name="arrow" size={20} /></a></p>
  </FaqList>
</Base>

<style>
  .rev-layout { display: grid; gap: 1rem; grid-template-columns: 1fr 1fr; }
  .rev-lead { grid-column: 1 / -1; }
  @media (min-width: 1000px) {
    .rev-layout { grid-template-columns: 1.6fr 1fr 1fr; }
    .rev-lead { grid-column: 1; grid-row: span 2; }
  }
  .rev-lead {
    position: relative; background: var(--blue); color: var(--navy); border-radius: var(--radius-lg);
    padding: clamp(1.6rem, 1rem + 3vw, 3rem); display: grid; gap: 1.2rem; align-content: start; overflow: hidden;
    box-shadow: var(--shadow);
  }
  .rev-quote { font-family: var(--font-display); font-weight: 900; font-size: 9rem; line-height: .6; height: 3.4rem; color: #fff; }
  .rev-lead p { font-size: clamp(1.15rem, 1.05rem + .5vw, 1.4rem); line-height: 1.5; font-weight: 550; }
  .rev-lead figcaption { font-weight: 650; }
  .rev-lead strong { font-family: var(--font-display); font-weight: 900; font-size: 1.2rem; }
  .rev-all { margin-top: 2rem; }
  .rev-inst { margin-top: 1rem; background: var(--navy); color: #fff; border-radius: var(--radius-lg); padding: clamp(1.6rem, 1rem + 3vw, 3rem); display: grid; gap: 1rem; }
  .rev-inst p { font-size: var(--step-1); line-height: 1.5; max-width: 70ch; }
  .rev-inst figcaption { display: grid; }
  .rev-inst strong { font-family: var(--font-display); font-size: 1.2rem; color: var(--blue); }
  .rev-inst span { color: #cfdaf0; }
  /* Phones: the institutional quote lives on the senior living and Green Valley pages. */
  @media (max-width: 699px) { .rev-inst { display: none; } }

  .story-grid { display: grid; gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: center; }
  @media (min-width: 1000px) { .story-grid { grid-template-columns: 1fr 1fr; } }
  .story-photos { position: relative; padding-bottom: 18%; }
  .sp-1 { aspect-ratio: 4 / 3; }
  .sp-2 { position: absolute; width: 52%; aspect-ratio: 4 / 3; right: -4%; bottom: 0; border: 6px solid #fff; transform: rotate(3deg); }
  .story-photos :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .story-copy { display: grid; gap: 1.1rem; justify-items: start; }
  .story-copy .h2 { font-size: clamp(1.9rem, 1.4rem + 2.2vw, 3rem); }
  /* Phones: a shorter quote mark, a wider story photo and the inset photo
     tucked closer, so these two sections take less scrolling. */
  @media (max-width: 699px) {
    /* Five lines of each quote before "Read the whole review", so the row stays short. */
    :global(.js) .rev-layout :global(blockquote p:not(.open)) { -webkit-line-clamp: 5; line-clamp: 5; }
    .rev-all { margin-top: 1.2rem; }
    .rev-lead { gap: .9rem; padding: 1.4rem 1.4rem 1.5rem; }
    .rev-quote { font-size: 6.5rem; height: 2.4rem; }
    .story-grid { gap: 1.6rem; }
    .story-photos { padding-bottom: 9%; }
    .sp-1 { aspect-ratio: 2 / 1; }
    .sp-2 { width: 40%; right: -2%; border-width: 4px; }
    .story-copy { gap: 1rem; }
    .story-copy .h2 { font-size: 1.75rem; }
    .story-copy .lede { font-size: 1.15rem; }
  }
  .story-copy a:not(.text-link) { font-weight: 700; }
</style>
